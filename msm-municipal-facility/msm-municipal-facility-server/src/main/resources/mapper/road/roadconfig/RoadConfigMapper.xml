    <select id="selectPageWithRoad"
            resultType="cn.iocoder.yudao.module.facility.controller.admin.road.roadconfig.vo.RoadConfigRespVO">
        SELECT
            rc.*,
            r.road_name
        FROM road_config rc
        LEFT JOIN road_facility r ON rc.road_id = r.id
        <where>

            <!-- eqIfPresent(RoadConfigDO::getConfigCode, reqVO.getConfigCode()) -->
            <if test="configCode != null and configCode != ''">
                AND rc.config_code = #{configCode}
            </if>

            <!-- likeIfPresent(RoadConfigDO::getName, reqVO.getName()) -->
            <if test="name != null and name != ''">
                AND rc.name LIKE CONCAT('%', #{name}, '%')
            </if>

            <!-- eqIfPresent(RoadConfigDO::getRoadId, reqVO.getRoadId()) -->
            <if test="roadId != null">
                AND rc.road_id = #{roadId}
            </if>

            <!-- likeIfPresent(RoadConfigDO::getRoadName, reqVO.getRoadName())（联表字段） -->
            <if test="roadName != null and roadName != ''">
                AND r.road_name LIKE CONCAT('%', #{roadName}, '%')
            </if>

            <!-- eqIfPresent(RoadConfigDO::getCollectFrequency, reqVO.getCollectFrequency()) -->
            <if test="collectFrequency != null">
                AND rc.collect_frequency = #{collectFrequency}
            </if>

            <!-- eqIfPresent(RoadConfigDO::getPotholeNumThreshold, reqVO.getPotholeNumThreshold()) -->
            <if test="potholeNumThreshold != null">
                AND rc.pothole_num_threshold = #{potholeNumThreshold}
            </if>

            <!-- eqIfPresent(RoadConfigDO::getCrackLengthThreshold, reqVO.getCrackLengthThreshold()) -->
            <if test="crackLengthThreshold != null">
                AND rc.crack_length_threshold = #{crackLengthThreshold}
            </if>

            <!-- eqIfPresent(RoadConfigDO::getRoadTempThreshold, reqVO.getRoadTempThreshold()) -->
            <if test="roadTempThreshold != null">
                AND rc.road_temp_threshold = #{roadTempThreshold}
            </if>

            <!-- eqIfPresent(RoadConfigDO::getTrafficFlowThreshold, reqVO.getTrafficFlowThreshold()) -->
            <if test="trafficFlowThreshold != null">
                AND rc.traffic_flow_threshold = #{trafficFlowThreshold}
            </if>

            <!-- betweenIfPresent(RoadConfigDO::getCreateTime, reqVO.getCreateTime()) -->
            <if test="createTime != null and createTime.size() == 2">
                AND rc.create_time BETWEEN #{createTime[0]} AND #{createTime[1]}
            </if>

            <!-- ext_common -->
            <if test="extCommon1 != null">
                AND rc.ext_common1 = #{extCommon1}
            </if>
            <if test="extCommon2 != null">
                AND rc.ext_common2 = #{extCommon2}
            </if>
            <if test="extCommon3 != null">
                AND rc.ext_common3 = #{extCommon3}
            </if>
            <if test="extCommon4 != null">
                AND rc.ext_common4 = #{extCommon4}
            </if>

        </where>
        ORDER BY rc.id DESC
    </select>
