<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.facility.dal.mysql.syswarn.SysWarnMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->
    <resultMap id="SysWarnResultMap"
               type="cn.iocoder.yudao.module.facility.dal.dataobject.syswarn.SysWarnDO">

        <id column="id" property="id"/>
        <result column="warn_no" property="warnNo"/>
        <result column="facility_id" property="facilityId"/>
        <result column="facility_name" property="facilityName"/>
        <result column="facility_code" property="facilityCode"/>
        <result column="work_order_id" property="workOrderId"/>
        <result column="work_order_code" property="workOrderCode"/>
        <result column="device_id" property="deviceId"/>
        <result column="device_code" property="deviceCode"/>
        <result column="monitor_id" property="monitorId"/>
        <result column="monitor_code" property="monitorCode"/>
        <result column="status" property="status"/>
        <result column="assign_status" property="assignStatus"/>
        <result column="facility_type" property="facilityType"/>
        <result column="type" property="type"/>
        <result column="way_type" property="wayType"/>
        <result column="level" property="level"/>
        <result column="trigger_time" property="triggerTime"/>
        <result column="deal_limit" property="dealLimit"/>
        <result column="over_index" property="overIndex"/>
        <result column="over_value" property="overValue"/>
        <result column="threshold_value" property="thresholdValue"/>
        <result column="confirm_opinion" property="confirmOpinion"/>
        <result column="invalid_reason" property="invalidReason"/>
        <result column="suggest" property="suggest"/>
        <result column="create_time" property="createTime"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>
    </resultMap>
    <select id="getSysWarnPage" resultType="cn.iocoder.yudao.module.facility.dal.dataobject.syswarn.SysWarnDO">
        SELECT *
        FROM sys_warn
        WHERE deleted = 0

        <if test="reqVO.warnNo != null and reqVO.warnNo != ''">
            AND warn_no LIKE CONCAT('%', #{reqVO.warnNo}, '%')
        </if>

        <if test="reqVO.facilityId != null">
            AND facility_id = #{reqVO.facilityId}
        </if>

        <if test="reqVO.facilityName != null and reqVO.facilityName != ''">
            AND facility_name LIKE CONCAT('%', #{reqVO.facilityName}, '%')
        </if>

        <if test="reqVO.facilityCode != null and reqVO.facilityCode != ''">
            AND facility_code = #{reqVO.facilityCode}
        </if>

        <if test="reqVO.workOrderId != null">
            AND work_order_id = #{reqVO.workOrderId}
        </if>

        <if test="reqVO.workOrderCode != null and reqVO.workOrderCode != ''">
            AND work_order_code = #{reqVO.workOrderCode}
        </if>

        <if test="reqVO.deviceId != null">
            AND device_id = #{reqVO.deviceId}
        </if>

        <if test="reqVO.deviceCode != null and reqVO.deviceCode != ''">
            AND device_code = #{reqVO.deviceCode}
        </if>

        <if test="reqVO.monitorId != null">
            AND monitor_id = #{reqVO.monitorId}
        </if>

        <if test="reqVO.monitorCode != null and reqVO.monitorCode != ''">
            AND monitor_code = #{reqVO.monitorCode}
        </if>

        <if test="reqVO.status != null and reqVO.status != ''">
            AND status = #{reqVO.status}
        </if>

        <if test="reqVO.assignStatus != null and reqVO.assignStatus != ''">
            AND assign_status = #{reqVO.assignStatus}
        </if>

        <if test="reqVO.facilityType != null and reqVO.facilityType != ''">
            AND facility_type = #{reqVO.facilityType}
        </if>

        <if test="reqVO.type != null and reqVO.type != ''">
            AND type = #{reqVO.type}
        </if>

        <if test="reqVO.wayType != null and reqVO.wayType != ''">
            AND way_type = #{reqVO.wayType}
        </if>

        <if test="reqVO.level != null">
            AND level = #{reqVO.level}
        </if>

        <if test="reqVO.triggerTime != null and reqVO.triggerTime.length == 2">
            AND trigger_time BETWEEN #{reqVO.triggerTime[0]} AND #{reqVO.triggerTime[1]}
        </if>

        <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
            AND create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
        </if>

        ORDER BY create_time DESC
    </select>

</mapper>
