<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.smartcampus.dal.mysql.archive.ArchiveMapper">

    <update id="audit">
        UPDATE student_archive
        SET process_status = #{processStatus},
        reject_reason = #{rejectReason},
        updater = #{updater},
        update_time = now()
        WHERE id IN
        <foreach item="id" collection="ids" separator="," close=")" open="(" index="">
            #{id}
        </foreach>
    </update>




</mapper>