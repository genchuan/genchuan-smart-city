<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.envir.dal.mysql.urbanvillage.UrbanVillageMapper">

    <!-- 城中村详情结果映射 -->
    <resultMap id="UrbanVillageDetailResultMap"
               type="cn.iocoder.yudao.module.envir.dal.dataobject.urbanvillage.UrbanVillageDetailDO">
        <id column="id" property="id"/>
        <result column="urban_village_id" property="urbanVillageId"/>
        <result column="name" property="name"/>
        <result column="address" property="address"/>
        <result column="area_code" property="areaCode"/>
        <result column="responsibility_areas" property="responsibilityAreas"/>
        <result column="area_divide_rule" property="areaDivideRule"/>
        <result column="road_cleaning_frequency" property="roadCleaningFrequency"/>
        <result column="waste_collection_time" property="wasteCollectionTime"/>
        <result column="manager_id" property="managerId"/>
        <result column="abnormal_create_by" property="abnormalCreateBy"/>
        <result column="abnormal_create_time" property="abnormalCreateTime"/>
        <result column="abnormal_update_time" property="abnormalUpdateTime"/>
        <result column="cleaning_rate" property="cleaningRate"/>
        <result column="problem_rate" property="problemRate"/>
        <result column="assessment_score" property="assessmentScore"/>
        <result column="problem_photo_url" property="problemPhotoUrl"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>

        <!-- 关联查询的额外字段 -->
        <result column="area_name" property="areaName"/>
        <result column="user_name" property="managerName"/>
    </resultMap>

    <select id="selectListDetail" resultMap="UrbanVillageDetailResultMap">
        SELECT
        uv.*,
        a.area_name AS area_name,
        u.user_name AS user_name
        FROM urban_village uv
        LEFT JOIN sys_area a ON uv.area_code = a.area_code AND a.deleted = 0
        LEFT JOIN sys_user u ON uv.manager_id = u.user_id AND u.deleted = 0
        WHERE uv.deleted = 0
        ORDER BY uv.id DESC
    </select>
</mapper>