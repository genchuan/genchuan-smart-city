<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.envir.dal.mysql.publicinstitution.PublicInstitutionMapper">

    <resultMap id="PublicInstitutionDetailResultMap" type="cn.iocoder.yudao.module.envir.dal.dataobject.publicinstitution.PublicInstitutionDetailDO">
        <!-- 继承 PublicInstitutionDO 的基础字段 -->
        <id column="id" property="id"/>
        <result column="public_institution_id" property="publicInstitutionId"/>
        <result column="name" property="name"/>
        <result column="institution_type_id" property="institutionTypeId"/>
        <result column="address" property="address"/>
        <result column="area_code" property="areaCode"/>
        <result column="cleaning_standard" property="cleaningStandard"/>
        <result column="cleaning_frequency" property="cleaningFrequency"/>
        <result column="collection_time" property="collectionTime"/>
        <result column="manager_id" property="managerId"/>
        <result column="abnormal_create_by" property="abnormalCreateBy"/>
        <result column="abnormal_create_time" property="abnormalCreateTime"/>
        <result column="abnormal_update_time" property="abnormalUpdateTime"/>
        <result column="cleaning_rate" property="cleaningRate"/>
        <result column="problem_rate" property="problemRate"/>
        <result column="waste_volume" property="wasteVolume"/>
        <result column="problem_location" property="problemLocation"/>
        <result column="cleaning_photo_url" property="cleaningPhotoUrl"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>

        <!-- 关联字段 -->
        <result column="institution_type_name" property="institutionTypeName"/>
        <result column="area_name" property="areaName"/>
        <result column="manager_name" property="managerName"/>
    </resultMap>

    <select id="selectListDetail" resultMap="PublicInstitutionDetailResultMap">
        SELECT
            pi.*,
            it.name AS institution_type_name,
            a.area_name AS area_name,
            u.user_name AS manager_name
        FROM public_institution pi
                 LEFT JOIN sys_institution_type it ON pi.institution_type_id = it.sys_institution_type_id AND it.deleted = 0
                 LEFT JOIN sys_area a ON pi.area_code = a.area_code AND a.deleted = 0
                 LEFT JOIN sys_user u ON pi.manager_id = u.user_id AND u.deleted = 0
        WHERE pi.deleted = 0
        ORDER BY pi.id DESC
    </select>

</mapper>