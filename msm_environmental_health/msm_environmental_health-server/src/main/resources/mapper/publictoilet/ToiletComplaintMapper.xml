<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.envirhealth.dal.mysql.publictoilet.ToiletComplaintMapper">

    <resultMap id="ToiletComplaintDetailResultMap" type="cn.iocoder.yudao.module.envirhealth.dal.dataobject.publictoilet.detail.ToiletComplaintDetailDO">
        <!-- 基础投诉字段（继承自 ToiletComplaintDO） -->
        <id column="id" property="id"/>
        <result column="complaint_id" property="complaintId"/>
        <result column="toilet_id" property="toiletId"/>
        <result column="complaint_type_id" property="complaintTypeId"/>
        <result column="content" property="content"/>
        <result column="complaint_name" property="complaintName"/>
        <result column="phone" property="phone"/>
        <result column="complaint_time" property="complaintTime"/>
        <result column="dispatch_status" property="dispatchStatus"/>
        <result column="handler_id" property="handlerId"/>
        <result column="is_timeout" property="isTimeout"/>
        <result column="handle_measure" property="handleMeasure"/>
        <result column="handle_result" property="handleResult"/>
        <result column="reform_photo" property="reformPhoto"/>
        <result column="feedback_content" property="feedbackContent"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>

        <!-- 关联查询的扩展字段 -->
        <result column="toilet_name" property="toiletName"/>
        <result column="complaint_type_name" property="complaintTypeName"/>
        <result column="handler_Name" property="handlerName"/>
    </resultMap>

    <select id="selectDetailPage" resultMap="ToiletComplaintDetailResultMap">
        SELECT
        tc.*,
        pt.name AS toilet_name,
        ct.complaint_name AS complaint_type_name,
        u.user_name AS handler_Name
        FROM public_toilet_complaint tc
        LEFT JOIN public_toilet pt ON tc.toilet_id = pt.toilet_id AND pt.deleted = 0
        LEFT JOIN sys_complaint_type ct ON tc.complaint_type_id = ct.complaint_type_id AND ct.deleted = 0
        LEFT JOIN sys_user u ON u.user_id = tc.handler_id AND tc.deleted = 0
        WHERE tc.deleted = 0
        ORDER BY tc.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <select id="selectCount" resultType="Long">
        SELECT COUNT(*)
        FROM public_toilet_complaint tc
        WHERE tc.deleted = 0
    </select>


</mapper>