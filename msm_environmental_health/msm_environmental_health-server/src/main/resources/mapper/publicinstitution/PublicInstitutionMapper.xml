<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.envirhealth.dal.mysql.publicinstitution.PublicInstitutionMapper">

    <!-- 公共机构详情查询结果映射 -->
    <resultMap id="PublicInstitutionDetailResultMap" type="cn.iocoder.yudao.module.envirhealth.dal.dataobject.publicinstitution.detail.PublicInstitutionDetailDO">
        <!-- 继承PublicInstitutionDO的基础字段 -->
        <result column="id" property="id"/>
        <result column="institution_id" property="institutionId"/>
        <result column="name" property="name"/>
        <result column="institution_type_id" property="institutionTypeId"/>
        <result column="address" property="address"/>
        <result column="area_code" property="areaCode"/>
        <result column="manager_id" property="managerId"/>
        <result column="operation_status_id" property="operationStatusId"/>
        <result column="cleaning_rate" property="cleaningRate"/>
        <result column="problem_rate" property="problemRate"/>
        <result column="waste_volume" property="wasteVolume"/>
        <result column="inspection_pass_rate" property="inspectionPassRate"/>
        <result column="cleaning_standard" property="cleaningStandard"/>
        <result column="cleaning_frequency" property="cleaningFrequency"/>
        <result column="cleaning_time" property="cleaningTime"/>
        <result column="cleaner_ids" property="cleanerIds"/>
        <result column="responsibility_area" property="responsibilityArea"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>

        <!-- 关联表字段 -->
        <result column="institution_type_name" property="institutionTypeName"/>
        <result column="area_name" property="areaName"/>
        <result column="manager_name" property="managerName"/>
        <result column="operation_status_name" property="operationStatusName"/>
    </resultMap>

    <!-- 联表查询公共机构详情列表 -->
    <select id="selectDetailPage" resultMap="PublicInstitutionDetailResultMap">
        SELECT
        pi.*,
        it.name AS institution_type_name,
        a.area_name AS area_name,
        u.user_name AS manager_name,
        os.name AS operation_status_name
        FROM public_institution pi
        LEFT JOIN sys_institution_type it ON pi.institution_type_id = it.sys_institution_type_id
        LEFT JOIN sys_area a ON pi.area_code = a.area_code
        LEFT JOIN sys_user u ON pi.manager_id = u.user_id
        LEFT JOIN sys_operation_status os ON pi.operation_status_id = os.sys_operation_status_id
        WHERE pi.deleted = 0
        ORDER BY pi.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <!-- 联表查询公共机构总数 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM public_institution pi
        WHERE pi.deleted = 0
    </select>

</mapper>