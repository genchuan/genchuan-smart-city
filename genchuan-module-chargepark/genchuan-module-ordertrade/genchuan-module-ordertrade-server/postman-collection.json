              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "tenant-id",    "value": "{{tenantId}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"id\": {{allOrderId}} }" },
            "url": { "raw": "{{baseUrl}}/ordertrade/all-order/invoice", "host": ["{{baseUrl}}"], "path": ["ordertrade","all-order","invoice"] }
          }
        },
        {
          "name": "Step7 查看图表统计",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.test('统计成功，code=200', () => pm.expect(json.code).to.eql(200));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "tenant-id", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/ordertrade/all-order/chart?startTime=2025-01-01 00:00:00&endTime=2025-12-31 23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["ordertrade","all-order","chart"],
              "query": [
                { "key": "startTime", "value": "2025-01-01 00:00:00" },
                { "key": "endTime",   "value": "2025-12-31 23:59:59" }
              ]
            }
          }
        },
        {
          "name": "Step8 导出Excel",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('导出响应正常(200)', () => pm.expect(pm.response.code).to.eql(200));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "tenant-id", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/ordertrade/all-order/export?pageNo=1&pageSize=999",
