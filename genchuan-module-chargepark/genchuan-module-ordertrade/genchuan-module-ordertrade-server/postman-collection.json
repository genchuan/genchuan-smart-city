    "description": "genchuan-module-ordertrade 完整接口测试集合\n\n使用前：\n1. 先执行 test-data.sql 写入基础数据\n2. 配置环境变量 baseUrl 和 tenantId\n3. 按闭环顺序运行，ID 会自动通过脚本传递",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:58090", "type": "string" },
    { "key": "tenantId",  "value": "1",                      "type": "string" },
    { "key": "allOrderId",      "value": "9",  "type": "string" },
    { "key": "tempParkOrderId", "value": "4",  "type": "string" },
    { "key": "chargeOrderId",   "value": "1",  "type": "string" },
    { "key": "refundApplyId",   "value": "1",  "type": "string" },
    { "key": "amountCheckId",   "value": "1",  "type": "string" },
    { "key": "debtIdentifyId",  "value": "1",  "type": "string" },
