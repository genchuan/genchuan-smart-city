    {
      "name": "闭环1 - 停车订单完整生命周期",
      "description": "流程：创建主订单 → 创建子订单 → 查询 → 支付 → 开票 → 统计 → 导出",
      "item": [
        {
          "name": "Step1 创建主订单",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.code === 200 && json.data) {",
                "    pm.collectionVariables.set('allOrderId', json.data);",
                "    console.log('allOrderId 已保存:', json.data);",
                "}",
                "pm.test('创建成功，code=200', () => pm.expect(json.code).to.eql(200));",
                "pm.test('返回订单ID > 0', () => pm.expect(json.data).to.be.above(0));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "tenant-id",    "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNo\": \"NEW-PARK-001\",\n  \"userId\": 1001,\n  \"stationId\": 1,\n  \"type\": \"temp_park\",\n  \"totalAmount\": 30.00,\n  \"payAmount\": 30.00,\n  \"status\": \"pending_pay\",\n  \"remark\": \"新建停车订单\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordertrade/all-order/create", "host": ["{{baseUrl}}"], "path": ["ordertrade","all-order","create"] }
          }
        },
        {
          "name": "Step2 创建临时停车子订单",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.code === 200 && json.data) {",
                "    pm.collectionVariables.set('tempParkOrderId', json.data);",
                "}",
                "pm.test('创建成功，code=200', () => pm.expect(json.code).to.eql(200));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "tenant-id",    "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{allOrderId}},\n  \"spaceId\": 101,\n  \"inTime\": \"2025-04-11 10:00:00\",\n  \"parkHour\": 2.0,\n  \"fee\": 30.00,\n  \"remark\": \"B区101车位\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordertrade/temp-park-order/create", "host": ["{{baseUrl}}"], "path": ["ordertrade","temp-park-order","create"] }
          }
        },
        {
          "name": "Step3 查询订单列表（确认创建）",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.test('查询成功，code=200', () => pm.expect(json.code).to.eql(200));",
                "pm.test('list不为空', () => pm.expect(json.data.list).to.be.an('array').that.is.not.empty);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "tenant-id", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/ordertrade/all-order/page?pageNo=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["ordertrade","all-order","page"],
              "query": [{ "key": "pageNo", "value": "1" }, { "key": "pageSize", "value": "10" }]
            }
          }
        },
        {
          "name": "Step4 查询订单详情",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.test('查询成功，code=200', () => pm.expect(json.code).to.eql(200));",
                "pm.test('data不为null', () => pm.expect(json.data).to.not.be.null);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "tenant-id", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/ordertrade/all-order/get?id={{allOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordertrade","all-order","get"],
              "query": [{ "key": "id", "value": "{{allOrderId}}" }]
            }
          }
        },
        {
          "name": "Step5 支付订单",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.test('支付成功，code=200', () => pm.expect(json.code).to.eql(200));",
                "pm.test('data=true', () => pm.expect(json.data).to.eql(true));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "tenant-id",    "value": "{{tenantId}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"id\": {{allOrderId}} }" },
            "url": { "raw": "{{baseUrl}}/ordertrade/all-order/pay", "host": ["{{baseUrl}}"], "path": ["ordertrade","all-order","pay"] }
          }
        },
        {
          "name": "Step6 申请开票",
          "event": [{
            "listen": "test",
