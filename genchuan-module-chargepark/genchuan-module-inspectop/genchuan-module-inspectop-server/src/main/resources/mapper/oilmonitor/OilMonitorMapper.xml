<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.oilmonitor.OilMonitorMapper">

    <!-- 定义结果映射器，将数据库列映射到 OilMonitorRespVO 属性 -->
    <resultMap id="OilMonitorRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.oilmonitor.vo.OilMonitorRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>

        <!-- OilMonitorDO 基础字段 -->
        <result column="space_id" property="spaceId" jdbcType="BIGINT"/>
        <result column="station_id" property="stationId" jdbcType="BIGINT"/>
        <result column="identify_time" property="identifyTime" jdbcType="TIMESTAMP"/>
        <result column="process_status" property="processStatus" jdbcType="VARCHAR"/>
        <result column="process_user_id" property="processUserId" jdbcType="BIGINT"/>
        <result column="process_time" property="processTime" jdbcType="TIMESTAMP"/>
        <result column="ignore_reason" property="ignoreReason" jdbcType="VARCHAR"/>
        <result column="process_progress" property="processProgress" jdbcType="INTEGER"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>

        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>

        <!-- 关联查询字段 -->
        <result column="space_no" property="spaceNo" jdbcType="VARCHAR"/>
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <!-- 【新增】分页查询方法 -->
    <select id="selectPageWithJoin" resultMap="OilMonitorRespVOResultMap">
        SELECT
        om.id,
        om.space_id,
        om.station_id,
        om.identify_time,
        om.process_status,
        om.process_user_id,
        om.process_time,
        om.ignore_reason,
        om.process_progress,
        om.longitude,
        om.latitude,
        om.reserve1,
        om.reserve2,
        om.creator,
        om.updater,
        om.create_time,
        om.update_time,
        psi.space_no,
        si.name AS station_name
        FROM oil_monitor om
        LEFT JOIN parking_space_info psi ON om.space_id = psi.id
        LEFT JOIN station_info si ON om.station_id = si.id
        <where>
            <!-- 车位ID -->
            <if test="reqVO.spaceId != null">
                AND om.space_id = #{reqVO.spaceId}
            </if>

            <!-- 场站ID -->
            <if test="reqVO.stationId != null">
                AND om.station_id = #{reqVO.stationId}
            </if>

            <!-- 识别时间范围 -->
            <if test="reqVO.identifyTime != null and reqVO.identifyTime.length == 2">
                AND om.identify_time BETWEEN #{reqVO.identifyTime[0]} AND #{reqVO.identifyTime[1]}
            </if>

            <!-- 处置状态 -->
            <if test="reqVO.processStatus != null and reqVO.processStatus != ''">
                AND om.process_status = #{reqVO.processStatus}
            </if>

            <!-- 处置人ID -->
            <if test="reqVO.processUserId != null">
                AND om.process_user_id = #{reqVO.processUserId}
            </if>

            <!-- 处置时间范围 -->
            <if test="reqVO.processTime != null and reqVO.processTime.length == 2">
                AND om.process_time BETWEEN #{reqVO.processTime[0]} AND #{reqVO.processTime[1]}
            </if>

            <!-- 忽略理由 -->
            <if test="reqVO.ignoreReason != null and reqVO.ignoreReason != ''">
                AND om.ignore_reason = #{reqVO.ignoreReason}
            </if>

            <!-- 处置进度 -->
            <if test="reqVO.processProgress != null">
                AND om.process_progress = #{reqVO.processProgress}
            </if>

            <!-- 经度 -->
            <if test="reqVO.longitude != null">
                AND om.longitude = #{reqVO.longitude}
            </if>

            <!-- 纬度 -->
            <if test="reqVO.latitude != null">
                AND om.latitude = #{reqVO.latitude}
            </if>

            <!-- 备用字段1 -->
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND om.reserve1 = #{reqVO.reserve1}
            </if>

            <!-- 备用字段2 -->
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND om.reserve2 = #{reqVO.reserve2}
            </if>

            <!-- 创建者 -->
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND om.creator = #{reqVO.creator}
            </if>

            <!-- 更新者 -->
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND om.updater = #{reqVO.updater}
            </if>

            <!-- 创建时间范围 -->
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND om.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>

            <!-- 更新时间范围 -->
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND om.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
        </where>
        ORDER BY om.id DESC
    </select>

    <!-- 查询趋势数据 (按小时分组统计识别次数) -->
    <select id="selectTrendData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.oilmonitor.vo.OilMonitorChartRespVO$TrendData">
        SELECT
        DATE_FORMAT(identify_time, '%H') AS time,
        COUNT(*) AS identifyCount
        FROM oil_monitor
        <where>
            <if test="reqVO.stationId != null">
            AND station_id = #{reqVO.stationId}
        </if>
        <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
        AND identify_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
        </if>
        </where>
            GROUP BY DATE_FORMAT(identify_time, '%H')
            ORDER BY time
    </select>

    <!-- 查询场站数据 (按场站分组统计占位次数，关联场站表获取名称) -->
    <select id="selectStationData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.oilmonitor.vo.OilMonitorChartRespVO$StationData">
    SELECT
    si.name AS stationName,
    COUNT(om.id) AS count
    FROM oil_monitor om
    LEFT JOIN station_info si ON om.station_id = si.id
    <where>
        <if test="reqVO.stationId != null">
        AND om.station_id = #{reqVO.stationId}
        </if>
        <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
    AND om.identify_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
        </if>
    </where>
        GROUP BY om.station_id, si.name
        ORDER BY count DESC
    </select>

        <!-- 查询卡片数据 (计算待处置数量和总处置完成率) -->
    <select id="selectCardData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.oilmonitor.vo.OilMonitorChartRespVO$CardData">
        SELECT
        SUM(CASE WHEN process_status IS NULL OR process_status = 'WAITING' THEN 1 ELSE 0 END) AS waitProcessCount,
        CASE
        WHEN COUNT(*) = 0 THEN 0
        ELSE ROUND(SUM(CASE WHEN process_status = 'FINISHED' THEN 1 ELSE 0 END) * 1.0 / COUNT(*), 2)
        END AS processFinishRate
        FROM oil_monitor
        <where>
        <if test="reqVO.stationId != null">
        AND station_id = #{reqVO.stationId}
        </if>
        <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
        AND identify_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
        </if>
        </where>
    </select>

</mapper>