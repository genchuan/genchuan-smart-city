<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.fencemgmt.FenceMgmtMapper">

    <!-- 在 <mapper> 标签内新增以下 <resultMap> 和 <select> 节点 -->
    <resultMap id="FenceMgmtRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.fencemgmt.vo.FenceMgmtRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>
        <!-- FenceMgmtDO 基础字段 -->
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="area" property="area" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="alarm_count" property="alarmCount" jdbcType="INTEGER"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>
        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <!-- 关联查询字段 - 巡检人员姓名 -->
        <result column="user_name" property="userName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 分页查询方法（关联查询巡检人员姓名） -->
    <select id="selectPageWithJoin" resultMap="FenceMgmtRespVOResultMap">
        SELECT
        fm.id,
        fm.name,
        fm.area,
        fm.user_id,
        fm.status,
        fm.alarm_count,
        fm.reserve1,
        fm.reserve2,
        fm.creator,
        fm.updater,
        fm.create_time,
        fm.update_time,
        iu.name AS user_name  -- 从 inspect_user 表获取巡检人员姓名
        FROM fence_mgmt fm
        LEFT JOIN inspect_user iu ON fm.user_id = iu.id
        <where>
            <if test="reqVO.name != null and reqVO.name != ''">
                AND fm.name LIKE CONCAT('%', #{reqVO.name}, '%')
            </if>
            <if test="reqVO.area != null and reqVO.area != ''">
                AND fm.area = #{reqVO.area}
            </if>
            <if test="reqVO.userId != null">
                AND fm.user_id = #{reqVO.userId}
            </if>
            <if test="reqVO.status != null and reqVO.status != ''">
                AND fm.status = #{reqVO.status}
            </if>
            <if test="reqVO.alarmCount != null">
                AND fm.alarm_count = #{reqVO.alarmCount}
            </if>
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND fm.reserve1 = #{reqVO.reserve1}
            </if>
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND fm.reserve2 = #{reqVO.reserve2}
            </if>
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND fm.creator = #{reqVO.creator}
            </if>
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND fm.updater = #{reqVO.updater}
            </if>
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND fm.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND fm.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
            AND fm.deleted = 0
        </where>
        ORDER BY fm.id DESC
    </select>

    <!-- 查询地图数据：获取所有围栏的区域信息 -->
    <select id="selectFenceDataForMap" resultType="cn.iocoder.yudao.module.inspectop.dal.mysql.fencemgmt.FenceMgmtMapper$MapDataDTO">
        SELECT
            id,
            name,
            area,
            status
        FROM fence_mgmt
        WHERE deleted = 0
          AND area IS NOT NULL
          AND area != ''
        ORDER BY id
    </select>

    <!-- 查询卡片统计数据：统计围栏总数和告警触发总数 -->
    <select id="selectChartCardData" resultType="cn.iocoder.yudao.module.inspectop.dal.mysql.fencemgmt.FenceMgmtMapper$CardDataDTO">
        SELECT
            COUNT(*) AS fenceCount,
            COALESCE(SUM(alarm_count), 0) AS alarmCount
        FROM fence_mgmt
        WHERE deleted = 0
    </select>

</mapper>