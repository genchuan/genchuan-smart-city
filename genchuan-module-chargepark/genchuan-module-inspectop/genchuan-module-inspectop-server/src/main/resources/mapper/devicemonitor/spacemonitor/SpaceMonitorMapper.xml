<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.devicemonitor.spacemonitor.SpaceMonitorMapper">

    <!-- 定义结果映射器，将数据库列映射到 SpaceMonitorRespVO 属性 -->
    <resultMap id="SpaceMonitorRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.spacemonitor.vo.SpaceMonitorRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>

        <!-- SpaceMonitorDO 基础字段 -->
        <result column="space_id" property="spaceId" jdbcType="BIGINT"/>
        <result column="station_id" property="stationId" jdbcType="BIGINT"/>
        <result column="monitor_time" property="monitorTime" jdbcType="TIMESTAMP"/>
        <result column="monitor_status" property="monitorStatus" jdbcType="VARCHAR"/>
        <result column="alarm_status" property="alarmStatus" jdbcType="VARCHAR"/>
        <result column="alarm_time" property="alarmTime" jdbcType="TIMESTAMP"/>
        <result column="alarm_remark" property="alarmRemark" jdbcType="VARCHAR"/>
        <result column="process_status" property="processStatus" jdbcType="VARCHAR"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>

        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>

        <!-- 关联查询字段 -->
        <result column="space_no" property="spaceNo" jdbcType="VARCHAR"/>
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 分页查询方法 -->
    <select id="selectPageWithJoin" resultMap="SpaceMonitorRespVOResultMap">
        SELECT
        sm.id,
        sm.space_id,
        sm.station_id,
        sm.monitor_time,
        sm.monitor_status,
        sm.alarm_status,
        sm.alarm_time,
        sm.alarm_remark,
        sm.process_status,
        sm.longitude,
        sm.latitude,
        sm.reserve1,
        sm.reserve2,
        sm.creator,
        sm.updater,
        sm.create_time,
        sm.update_time,
        psi.space_no,
        si.name AS station_name
        FROM space_monitor sm
        LEFT JOIN parking_space_info psi ON sm.space_id = psi.id
        LEFT JOIN station_info si ON sm.station_id = si.id
        <where>
            <!-- 车位ID -->
            <if test="reqVO.spaceId != null">
                AND sm.space_id = #{reqVO.spaceId}
            </if>

            <!-- 场站ID -->
            <if test="reqVO.stationId != null">
                AND sm.station_id = #{reqVO.stationId}
            </if>
            <!-- 【新增条件】场站名称模糊查询 -->
            <if test="reqVO.stationName != null and reqVO.stationName != ''">
                AND si.name LIKE CONCAT('%', #{reqVO.stationName}, '%')
            </if>
            <!-- 监测时间范围 -->
            <if test="reqVO.monitorTime != null and reqVO.monitorTime.length == 2">
                AND sm.monitor_time BETWEEN #{reqVO.monitorTime[0]} AND #{reqVO.monitorTime[1]}
            </if>

            <!-- 监测状态 -->
            <if test="reqVO.monitorStatus != null and reqVO.monitorStatus != ''">
                AND sm.monitor_status = #{reqVO.monitorStatus}
            </if>

            <!-- 告警状态 -->
            <if test="reqVO.alarmStatus != null and reqVO.alarmStatus != ''">
                AND sm.alarm_status = #{reqVO.alarmStatus}
            </if>

            <!-- 告警时间范围 -->
            <if test="reqVO.alarmTime != null and reqVO.alarmTime.length == 2">
                AND sm.alarm_time BETWEEN #{reqVO.alarmTime[0]} AND #{reqVO.alarmTime[1]}
            </if>

            <!-- 告警备注 -->
            <if test="reqVO.alarmRemark != null and reqVO.alarmRemark != ''">
                AND sm.alarm_remark = #{reqVO.alarmRemark}
            </if>

            <!-- 处理状态 -->
            <if test="reqVO.processStatus != null and reqVO.processStatus != ''">
                AND sm.process_status = #{reqVO.processStatus}
            </if>

            <!-- 经度 -->
            <if test="reqVO.longitude != null">
                AND sm.longitude = #{reqVO.longitude}
            </if>

            <!-- 纬度 -->
            <if test="reqVO.latitude != null">
                AND sm.latitude = #{reqVO.latitude}
            </if>

            <!-- 备用字段1 -->
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND sm.reserve1 = #{reqVO.reserve1}
            </if>

            <!-- 备用字段2 -->
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND sm.reserve2 = #{reqVO.reserve2}
            </if>

            <!-- 创建者 -->
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND sm.creator = #{reqVO.creator}
            </if>

            <!-- 更新者 -->
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND sm.updater = #{reqVO.updater}
            </if>

            <!-- 创建时间范围 -->
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND sm.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>

            <!-- 【新增】创建日期（精确到天） -->
            <if test="reqVO.createDate != null">
                AND DATE(sm.create_time) = #{reqVO.createDate}
            </if>

            <!-- 更新时间范围 -->
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND sm.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
        </where>
        ORDER BY sm.id DESC
    </select>

    <!-- 根据ID查询定位信息 -->
    <select id="selectLocationById" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.spacemonitor.vo.SpaceMonitorLocationRespVO">
        SELECT
            sm.longitude,
            sm.latitude,
            si.name AS stationName,
            psi.space_no AS spaceCode
        FROM space_monitor sm
                 LEFT JOIN parking_space_info psi ON sm.space_id = psi.id
                 LEFT JOIN station_info si ON sm.station_id = si.id
        WHERE sm.id = #{id}
    </select>

    <!-- 查询地图数据 -->
    <select id="selectMapData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.spacemonitor.vo.SpaceMonitorChartRespVO$MapData">
        SELECT
        sm.id,
        psi.space_no AS name,
        CASE sm.monitor_status
        WHEN '1' THEN '正常'
        WHEN '2' THEN '异常'
        ELSE sm.monitor_status
        END AS status,
        sm.longitude,
        sm.latitude
        FROM space_monitor sm
        INNER JOIN (
        SELECT space_id, MAX(monitor_time) AS max_time
        FROM space_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        GROUP BY space_id
        ) latest ON sm.space_id = latest.space_id AND sm.monitor_time = latest.max_time
        LEFT JOIN parking_space_info psi ON sm.space_id = psi.id
        <!-- 关键修复：外层查询也需要相同的筛选条件 -->
        <where>
            <if test="reqVO.stationId != null">
                AND sm.station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND sm.monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
    </select>

    <!-- 查询趋势数据 -->
    <select id="selectTrendData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.spacemonitor.vo.SpaceMonitorChartRespVO$TrendData">
        SELECT
        DATE_FORMAT(monitor_time, '%H') AS time,
        <!-- 修改这里：1表示正常，2表示异常 -->
        SUM(CASE WHEN monitor_status = '1' THEN 1 ELSE 0 END) AS normalCount,
        SUM(CASE WHEN monitor_status = '2' THEN 1 ELSE 0 END) AS abnormalCount
        FROM space_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        GROUP BY DATE_FORMAT(monitor_time, '%H')
        ORDER BY time
    </select>

    <!-- 查询卡片数据 -->
    <select id="selectCardData" resultType="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.spacemonitor.vo.SpaceMonitorChartRespVO$CardData">
        SELECT
        <!-- 修改这里：1表示正常，2表示异常 -->
        SUM(CASE WHEN sm.monitor_status = '1' THEN 1 ELSE 0 END) AS normalSpace,
        SUM(CASE WHEN sm.monitor_status = '2' THEN 1 ELSE 0 END) AS abnormalSpace
        FROM space_monitor sm
