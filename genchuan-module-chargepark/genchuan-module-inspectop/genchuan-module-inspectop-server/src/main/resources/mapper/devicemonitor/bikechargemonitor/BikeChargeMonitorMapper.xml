<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.devicemonitor.bikechargemonitor.BikeChargeMonitorMapper">

    <!-- 定义结果映射器，将数据库列映射到 BikeChargeMonitorRespVO 属性 -->
    <resultMap id="BikeChargeMonitorRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.bikechargemonitor.vo.BikeChargeMonitorRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>

        <!-- BikeChargeMonitorDO 基础字段 -->
        <result column="device_id" property="deviceId" jdbcType="BIGINT"/>
        <result column="station_id" property="stationId" jdbcType="BIGINT"/>
        <result column="monitor_time" property="monitorTime" jdbcType="TIMESTAMP"/>
        <result column="monitor_status" property="monitorStatus" jdbcType="VARCHAR"/>
        <result column="alarm_status" property="alarmStatus" jdbcType="VARCHAR"/>
        <result column="alarm_time" property="alarmTime" jdbcType="TIMESTAMP"/>
        <result column="alarm_remark" property="alarmRemark" jdbcType="VARCHAR"/>
        <result column="process_status" property="processStatus" jdbcType="VARCHAR"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>

        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>

        <!-- 关联查询字段 - 场站名称 -->
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 分页查询方法（关联查询场站名称） -->
    <select id="selectPageWithJoin" resultMap="BikeChargeMonitorRespVOResultMap">
        SELECT
        bcm.id,
        bcm.device_id,
        bcm.station_id,
        bcm.monitor_time,
        bcm.monitor_status,
        bcm.alarm_status,
        bcm.alarm_time,
        bcm.alarm_remark,
        bcm.process_status,
        bcm.longitude,
        bcm.latitude,
        bcm.reserve1,
        bcm.reserve2,
        bcm.creator,
        bcm.updater,
        bcm.create_time,
        bcm.update_time,
        si.name AS station_name
        FROM bike_charge_monitor bcm
        LEFT JOIN station_info si ON bcm.station_id = si.id
        <where>
            <!-- 设备ID -->
            <if test="reqVO.deviceId != null">
                AND bcm.device_id LIKE CONCAT('%', #{reqVO.deviceId}, '%')
            </if>

            <!-- 场站ID -->
            <if test="reqVO.stationId != null">
                AND bcm.station_id = #{reqVO.stationId}
            </if>
            <!-- 【新增条件】场站名称模糊查询 -->
            <if test="reqVO.stationName != null and reqVO.stationName != ''">
                AND si.name LIKE CONCAT('%', #{reqVO.stationName}, '%')
            </if>
            <!-- 监测时间范围 -->
            <if test="reqVO.monitorTime != null and reqVO.monitorTime.length == 2">
                AND bcm.monitor_time BETWEEN #{reqVO.monitorTime[0]} AND #{reqVO.monitorTime[1]}
            </if>

            <!-- 监测状态 -->
            <if test="reqVO.monitorStatus != null and reqVO.monitorStatus != ''">
                AND bcm.monitor_status = #{reqVO.monitorStatus}
            </if>

            <!-- 告警状态 -->
            <if test="reqVO.alarmStatus != null and reqVO.alarmStatus != ''">
                AND bcm.alarm_status = #{reqVO.alarmStatus}
            </if>

            <!-- 告警时间范围 -->
            <if test="reqVO.alarmTime != null and reqVO.alarmTime.length == 2">
                AND bcm.alarm_time BETWEEN #{reqVO.alarmTime[0]} AND #{reqVO.alarmTime[1]}
            </if>

            <!-- 告警备注 -->
            <if test="reqVO.alarmRemark != null and reqVO.alarmRemark != ''">
                AND bcm.alarm_remark = #{reqVO.alarmRemark}
            </if>

            <!-- 处理状态 -->
            <if test="reqVO.processStatus != null and reqVO.processStatus != ''">
                AND bcm.process_status = #{reqVO.processStatus}
            </if>

            <!-- 经度 -->
            <if test="reqVO.longitude != null">
                AND bcm.longitude = #{reqVO.longitude}
            </if>

            <!-- 纬度 -->
            <if test="reqVO.latitude != null">
                AND bcm.latitude = #{reqVO.latitude}
            </if>

            <!-- 备用字段1 -->
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND bcm.reserve1 = #{reqVO.reserve1}
            </if>

            <!-- 备用字段2 -->
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND bcm.reserve2 = #{reqVO.reserve2}
            </if>

            <!-- 创建者 -->
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND bcm.creator = #{reqVO.creator}
            </if>

            <!-- 更新者 -->
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND bcm.updater = #{reqVO.updater}
            </if>

            <!-- 创建时间范围 -->
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND bcm.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>

            <!-- 【新增】创建日期（精确到天） -->
            <if test="reqVO.createDate != null">
                AND DATE(bcm.create_time) = #{reqVO.createDate}
            </if>

            <!-- 更新时间范围 -->
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND bcm.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
        </where>
        ORDER BY bcm.id DESC
    </select>

    <!-- 定义定位查询结果映射器 -->
    <resultMap id="BikeChargeMonitorLocationRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.bikechargemonitor.vo.BikeChargeMonitorLocationRespVO">
        <result column="device_id" property="deviceCode" jdbcType="BIGINT"/> <!-- 修改：将 device_id 映射到 deviceCode -->
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 定位查询方法 -->
    <select id="selectLocationById" resultMap="BikeChargeMonitorLocationRespVOResultMap">
        SELECT
        bcm.device_id,
        bcm.longitude,
        bcm.latitude,
        si.name AS station_name
        FROM bike_charge_monitor bcm
        LEFT JOIN station_info si ON bcm.station_id = si.id
        WHERE bcm.id = #{id}
    </select>

    <!-- 定义地图数据查询结果映射器 -->
    <resultMap id="BikeChargeMonitorMapDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.bikechargemonitor.vo.BikeChargeMonitorChartRespVO$MapData">
        <result column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="lon" property="lon" jdbcType="DECIMAL"/>
        <result column="lat" property="lat" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 定义趋势数据查询结果映射器 -->
    <resultMap id="BikeChargeMonitorTrendDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.bikechargemonitor.vo.BikeChargeMonitorChartRespVO$TrendData">
        <result column="time" property="time" jdbcType="VARCHAR"/>
        <result column="normalCount" property="normalCount" jdbcType="INTEGER"/>
        <result column="abnormalCount" property="abnormalCount" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 定义卡片数据查询结果映射器 -->
    <resultMap id="BikeChargeMonitorCardDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.bikechargemonitor.vo.BikeChargeMonitorChartRespVO$CardData">
        <result column="normalDevice" property="normalDevice" jdbcType="INTEGER"/>
        <result column="abnormalDevice" property="abnormalDevice" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 查询地图数据（充电设备状态分布） -->
    <select id="selectMapData" resultMap="BikeChargeMonitorMapDataResultMap">
        SELECT
        bcm.id,
        CONCAT('BC-', LPAD(bcm.device_id, 2, '0')) AS name,
        CASE
        WHEN bcm.monitor_status = 'NORMAL' THEN '正常'
        ELSE '异常'
        END AS status,
        bcm.longitude AS lon,
        bcm.latitude AS lat
        FROM bike_charge_monitor bcm
        <where>
            <if test="reqVO.stationId != null">
                AND bcm.station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND bcm.monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        ORDER BY bcm.id
    </select>

    <!-- 查询趋势数据（按小时统计正常和异常设备数量） -->
    <select id="selectTrendData" resultMap="BikeChargeMonitorTrendDataResultMap">
        SELECT
        DATE_FORMAT(monitor_time, '%H') AS time,
        SUM(CASE WHEN monitor_status = 'NORMAL' THEN 1 ELSE 0 END) AS normalCount,
        SUM(CASE WHEN monitor_status != 'NORMAL' THEN 1 ELSE 0 END) AS abnormalCount
        FROM bike_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        GROUP BY DATE_FORMAT(monitor_time, '%H')
        ORDER BY time
    </select>

    <!-- 查询卡片数据（正常设备和异常设备数量） -->
    <select id="selectCardData" resultMap="BikeChargeMonitorCardDataResultMap">
        SELECT
        SUM(CASE WHEN monitor_status = '0' THEN 1 ELSE 0 END) AS normalDevice,
        SUM(CASE WHEN monitor_status != '0' THEN 1 ELSE 0 END) AS abnormalDevice
        FROM bike_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
    </select>

</mapper>