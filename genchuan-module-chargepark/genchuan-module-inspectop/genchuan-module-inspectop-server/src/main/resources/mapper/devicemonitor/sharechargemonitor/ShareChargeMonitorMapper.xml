<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.devicemonitor.sharechargemonitor.ShareChargeMonitorMapper">

    <!-- 定义结果映射器，将数据库列映射到 ShareChargeMonitorRespVO 属性 -->
    <resultMap id="ShareChargeMonitorRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.sharechargemonitor.vo.ShareChargeMonitorRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>

        <!-- ShareChargeMonitorDO 基础字段 -->
        <result column="device_id" property="deviceId" jdbcType="BIGINT"/>
        <result column="station_id" property="stationId" jdbcType="BIGINT"/>
        <result column="monitor_time" property="monitorTime" jdbcType="TIMESTAMP"/>
        <result column="monitor_status" property="monitorStatus" jdbcType="VARCHAR"/>
        <result column="alarm_status" property="alarmStatus" jdbcType="VARCHAR"/>
        <result column="alarm_time" property="alarmTime" jdbcType="TIMESTAMP"/>
        <result column="alarm_remark" property="alarmRemark" jdbcType="VARCHAR"/>
        <result column="process_status" property="processStatus" jdbcType="VARCHAR"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>

        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>

        <!-- 关联查询字段 - 场站名称 -->
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 分页查询方法（关联查询场站名称） -->
    <select id="selectPageWithJoin" resultMap="ShareChargeMonitorRespVOResultMap">
        SELECT
        scm.id,
        scm.device_id,
        scm.station_id,
        scm.monitor_time,
        scm.monitor_status,
        scm.alarm_status,
        scm.alarm_time,
        scm.alarm_remark,
        scm.process_status,
        scm.longitude,
        scm.latitude,
        scm.reserve1,
        scm.reserve2,
        scm.creator,
        scm.updater,
        scm.create_time,
        scm.update_time,
        si.name AS station_name
        FROM share_charge_monitor scm
        LEFT JOIN station_info si ON scm.station_id = si.id
        <where>
            <!-- 设备ID -->
            <if test="reqVO.deviceId != null">
                AND ccm.device_id LIKE CONCAT('%', #{reqVO.deviceId}, '%')
            </if>
            <!-- 场站ID -->
            <if test="reqVO.stationId != null">
                AND scm.station_id = #{reqVO.stationId}
            </if>
            <!-- 【新增条件】场站名称模糊查询 -->
            <if test="reqVO.stationName != null and reqVO.stationName != ''">
                AND si.name LIKE CONCAT('%', #{reqVO.stationName}, '%')
            </if>
            <!-- 监测时间范围 -->
            <if test="reqVO.monitorTime != null and reqVO.monitorTime.length == 2">
                AND scm.monitor_time BETWEEN #{reqVO.monitorTime[0]} AND #{reqVO.monitorTime[1]}
            </if>

            <!-- 监测状态 -->
            <if test="reqVO.monitorStatus != null and reqVO.monitorStatus != ''">
                AND scm.monitor_status = #{reqVO.monitorStatus}
            </if>

            <!-- 告警状态 -->
            <if test="reqVO.alarmStatus != null and reqVO.alarmStatus != ''">
                AND scm.alarm_status = #{reqVO.alarmStatus}
            </if>

            <!-- 告警时间范围 -->
            <if test="reqVO.alarmTime != null and reqVO.alarmTime.length == 2">
                AND scm.alarm_time BETWEEN #{reqVO.alarmTime[0]} AND #{reqVO.alarmTime[1]}
            </if>

            <!-- 告警备注 -->
            <if test="reqVO.alarmRemark != null and reqVO.alarmRemark != ''">
                AND scm.alarm_remark = #{reqVO.alarmRemark}
            </if>

            <!-- 处理状态 -->
            <if test="reqVO.processStatus != null and reqVO.processStatus != ''">
                AND scm.process_status = #{reqVO.processStatus}
            </if>

            <!-- 经度 -->
            <if test="reqVO.longitude != null">
                AND scm.longitude = #{reqVO.longitude}
            </if>

            <!-- 纬度 -->
            <if test="reqVO.latitude != null">
                AND scm.latitude = #{reqVO.latitude}
            </if>

            <!-- 备用字段1 -->
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND scm.reserve1 = #{reqVO.reserve1}
            </if>

            <!-- 备用字段2 -->
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND scm.reserve2 = #{reqVO.reserve2}
            </if>

            <!-- 创建者 -->
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND scm.creator = #{reqVO.creator}
            </if>

            <!-- 更新者 -->
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND scm.updater = #{reqVO.updater}
            </if>

            <!-- 创建时间范围 -->
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND scm.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>

            <!-- 更新时间范围 -->
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND scm.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
        </where>
        ORDER BY scm.id DESC
    </select>

    <!-- 定义定位查询结果映射器 -->
    <resultMap id="ShareChargeMonitorLocationRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.sharechargemonitor.vo.ShareChargeMonitorLocationRespVO">
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 定位查询方法 -->
    <select id="selectLocationById" resultMap="ShareChargeMonitorLocationRespVOResultMap">
        SELECT
            scm.longitude,
            scm.latitude,
            si.name AS station_name
        FROM share_charge_monitor scm
                 LEFT JOIN station_info si ON scm.station_id = si.id
        WHERE scm.id = #{id}
    </select>

    <!-- 定义地图数据查询结果映射器 -->
    <resultMap id="ShareChargeMonitorMapDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.sharechargemonitor.vo.ShareChargeMonitorChartRespVO$MapData">
        <result column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="lon" property="lon" jdbcType="DECIMAL"/>
        <result column="lat" property="lat" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 定义趋势数据查询结果映射器 -->
    <resultMap id="ShareChargeMonitorTrendDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.sharechargemonitor.vo.ShareChargeMonitorChartRespVO$TrendData">
        <result column="time" property="time" jdbcType="VARCHAR"/>
        <result column="normalCount" property="normalCount" jdbcType="INTEGER"/>
        <result column="abnormalCount" property="abnormalCount" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 定义卡片数据查询结果映射器 -->
    <resultMap id="ShareChargeMonitorCardDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.sharechargemonitor.vo.ShareChargeMonitorChartRespVO$CardData">
        <result column="normalDevice" property="normalDevice" jdbcType="INTEGER"/>
        <result column="abnormalDevice" property="abnormalDevice" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 查询地图数据（充电设备状态分布） -->
    <select id="selectMapData" resultMap="ShareChargeMonitorMapDataResultMap">
        SELECT
        scm.id,
        CONCAT('SC-', LPAD(scm.device_id, 2, '0')) AS name,
        CASE
        WHEN scm.monitor_status = 'NORMAL' THEN '正常'
        ELSE '异常'
        END AS status,
        scm.longitude AS lon,
        scm.latitude AS lat
        FROM share_charge_monitor scm
        <where>
            <if test="reqVO.stationId != null">
                AND scm.station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND scm.monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        ORDER BY scm.id
    </select>

    <!-- 查询趋势数据（按小时统计正常和异常设备数量） -->
    <select id="selectTrendData" resultMap="ShareChargeMonitorTrendDataResultMap">
        SELECT
        DATE_FORMAT(monitor_time, '%H') AS time,
        SUM(CASE WHEN monitor_status = 'NORMAL' THEN 1 ELSE 0 END) AS normalCount,
        SUM(CASE WHEN monitor_status != 'NORMAL' THEN 1 ELSE 0 END) AS abnormalCount
        FROM share_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        GROUP BY DATE_FORMAT(monitor_time, '%H')
        ORDER BY time
    </select>

    <!-- 查询卡片数据（正常设备和异常设备数量） -->
    <select id="selectCardData" resultMap="ShareChargeMonitorCardDataResultMap">
        SELECT
        SUM(CASE WHEN monitor_status = '0' THEN 1 ELSE 0 END) AS normalDevice,
        SUM(CASE WHEN monitor_status != '0' THEN 1 ELSE 0 END) AS abnormalDevice
        FROM share_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
    </select>

</mapper>