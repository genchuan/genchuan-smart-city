<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.inspectop.dal.mysql.devicemonitor.carchargemonitor.CarChargeMonitorMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <!-- 定义结果映射器，将数据库列映射到 CarChargeMonitorRespVO 属性 -->
    <resultMap id="CarChargeMonitorRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.carchargemonitor.vo.CarChargeMonitorRespVO">
        <!-- 主键ID -->
        <id column="id" property="id" jdbcType="BIGINT"/>

        <!-- CarChargeMonitorDO 基础字段 -->
        <result column="device_id" property="deviceId" jdbcType="BIGINT"/>
        <result column="station_id" property="stationId" jdbcType="BIGINT"/>
        <result column="monitor_time" property="monitorTime" jdbcType="TIMESTAMP"/>
        <result column="monitor_status" property="monitorStatus" jdbcType="VARCHAR"/>
        <result column="alarm_status" property="alarmStatus" jdbcType="VARCHAR"/>
        <result column="alarm_time" property="alarmTime" jdbcType="TIMESTAMP"/>
        <result column="alarm_remark" property="alarmRemark" jdbcType="VARCHAR"/>
        <result column="process_status" property="processStatus" jdbcType="VARCHAR"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="reserve1" property="reserve1" jdbcType="VARCHAR"/>
        <result column="reserve2" property="reserve2" jdbcType="VARCHAR"/>

        <!-- BaseDO 基础字段 -->
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="updater" property="updater" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>

        <!-- 关联查询字段 - 场站名称 -->
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 分页查询方法（关联查询场站名称） -->
    <select id="selectPageWithJoin" resultMap="CarChargeMonitorRespVOResultMap">
        SELECT
        ccm.id,
        ccm.device_id,
        ccm.station_id,
        ccm.monitor_time,
        ccm.monitor_status,
        ccm.alarm_status,
        ccm.alarm_time,
        ccm.alarm_remark,
        ccm.process_status,
        ccm.longitude,
        ccm.latitude,
        ccm.reserve1,
        ccm.reserve2,
        ccm.creator,
        ccm.updater,
        ccm.create_time,
        ccm.update_time,
        si.name AS station_name
        FROM car_charge_monitor ccm
        LEFT JOIN station_info si ON ccm.station_id = si.id
        <where>
            <!-- 设备ID -->
            <if test="reqVO.deviceId != null">
                AND ccm.device_id LIKE CONCAT('%', #{reqVO.deviceId}, '%')
            </if>

            <!-- 场站ID -->
            <if test="reqVO.stationId != null">
                AND ccm.station_id = #{reqVO.stationId}
            </if>
            <!-- 【新增条件】场站名称模糊查询 -->
            <if test="reqVO.stationName != null and reqVO.stationName != ''">
                AND si.name LIKE CONCAT('%', #{reqVO.stationName}, '%')
            </if>
            <!-- 监测时间范围 -->
            <if test="reqVO.monitorTime != null and reqVO.monitorTime.length == 2">
                AND ccm.monitor_time BETWEEN #{reqVO.monitorTime[0]} AND #{reqVO.monitorTime[1]}
            </if>

            <!-- 监测状态 -->
            <if test="reqVO.monitorStatus != null and reqVO.monitorStatus != ''">
                AND ccm.monitor_status = #{reqVO.monitorStatus}
            </if>

            <!-- 告警状态 -->
            <if test="reqVO.alarmStatus != null and reqVO.alarmStatus != ''">
                AND ccm.alarm_status = #{reqVO.alarmStatus}
            </if>

            <!-- 告警时间范围 -->
            <if test="reqVO.alarmTime != null and reqVO.alarmTime.length == 2">
                AND ccm.alarm_time BETWEEN #{reqVO.alarmTime[0]} AND #{reqVO.alarmTime[1]}
            </if>

            <!-- 告警备注 -->
            <if test="reqVO.alarmRemark != null and reqVO.alarmRemark != ''">
                AND ccm.alarm_remark = #{reqVO.alarmRemark}
            </if>

            <!-- 处理状态 -->
            <if test="reqVO.processStatus != null and reqVO.processStatus != ''">
                AND ccm.process_status = #{reqVO.processStatus}
            </if>

            <!-- 经度 -->
            <if test="reqVO.longitude != null">
                AND ccm.longitude = #{reqVO.longitude}
            </if>

            <!-- 纬度 -->
            <if test="reqVO.latitude != null">
                AND ccm.latitude = #{reqVO.latitude}
            </if>

            <!-- 备用字段1 -->
            <if test="reqVO.reserve1 != null and reqVO.reserve1 != ''">
                AND ccm.reserve1 = #{reqVO.reserve1}
            </if>

            <!-- 备用字段2 -->
            <if test="reqVO.reserve2 != null and reqVO.reserve2 != ''">
                AND ccm.reserve2 = #{reqVO.reserve2}
            </if>

            <!-- 创建者 -->
            <if test="reqVO.creator != null and reqVO.creator != ''">
                AND ccm.creator = #{reqVO.creator}
            </if>

            <!-- 更新者 -->
            <if test="reqVO.updater != null and reqVO.updater != ''">
                AND ccm.updater = #{reqVO.updater}
            </if>

            <!-- 创建时间范围 -->
            <if test="reqVO.createTime != null and reqVO.createTime.length == 2">
                AND ccm.create_time BETWEEN #{reqVO.createTime[0]} AND #{reqVO.createTime[1]}
            </if>

            <!-- 更新时间范围 -->
            <if test="reqVO.updateTime != null and reqVO.updateTime.length == 2">
                AND ccm.update_time BETWEEN #{reqVO.updateTime[0]} AND #{reqVO.updateTime[1]}
            </if>
        </where>
        ORDER BY ccm.id DESC
    </select>

    <!-- 定义定位查询结果映射器 -->
    <resultMap id="CarChargeMonitorLocationRespVOResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.carchargemonitor.vo.CarChargeMonitorLocationRespVO">
        <result column="device_id" property="deviceCode" jdbcType="DECIMAL"/>
        <result column="longitude" property="longitude" jdbcType="DECIMAL"/>
        <result column="latitude" property="latitude" jdbcType="DECIMAL"/>
        <result column="station_name" property="stationName" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 定位查询方法 -->
    <select id="selectLocationById" resultMap="CarChargeMonitorLocationRespVOResultMap">
        SELECT
            ccm.device_id,
            ccm.longitude,
            ccm.latitude,
            si.name AS station_name
        FROM car_charge_monitor ccm
                 LEFT JOIN station_info si ON ccm.station_id = si.id
        WHERE ccm.id = #{id}
    </select>

    <!-- 定义地图数据查询结果映射器 -->
    <resultMap id="CarChargeMonitorMapDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.carchargemonitor.vo.CarChargeMonitorChartRespVO$MapData">
        <result column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="lon" property="lon" jdbcType="DECIMAL"/>
        <result column="lat" property="lat" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 定义趋势数据查询结果映射器 -->
    <resultMap id="CarChargeMonitorTrendDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.carchargemonitor.vo.CarChargeMonitorChartRespVO$TrendData">
        <result column="time" property="time" jdbcType="VARCHAR"/>
        <result column="normalCount" property="normalCount" jdbcType="INTEGER"/>
        <result column="abnormalCount" property="abnormalCount" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 定义卡片数据查询结果映射器 -->
    <resultMap id="CarChargeMonitorCardDataResultMap" type="cn.iocoder.yudao.module.inspectop.controller.admin.devicemonitor.carchargemonitor.vo.CarChargeMonitorChartRespVO$CardData">
        <result column="normalDevice" property="normalDevice" jdbcType="INTEGER"/>
        <result column="abnormalDevice" property="abnormalDevice" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 查询地图数据（充电设备状态分布） -->
    <select id="selectMapData" resultMap="CarChargeMonitorMapDataResultMap">
        SELECT
        ccm.id,
        CONCAT('CC-', LPAD(ccm.device_id, 2, '0')) AS name,
        CASE
        WHEN ccm.monitor_status = 'NORMAL' THEN '正常'
        ELSE '异常'
        END AS status,
        ccm.longitude AS lon,
        ccm.latitude AS lat
        FROM car_charge_monitor ccm
        <where>
            <if test="reqVO.stationId != null">
                AND ccm.station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND ccm.monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        ORDER BY ccm.id
    </select>

    <!-- 查询趋势数据（按小时统计正常和异常设备数量） -->
    <select id="selectTrendData" resultMap="CarChargeMonitorTrendDataResultMap">
        SELECT
        DATE_FORMAT(monitor_time, '%H') AS time,
        SUM(CASE WHEN monitor_status = 'NORMAL' THEN 1 ELSE 0 END) AS normalCount,
        SUM(CASE WHEN monitor_status != 'NORMAL' THEN 1 ELSE 0 END) AS abnormalCount
        FROM car_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
        GROUP BY DATE_FORMAT(monitor_time, '%H')
        ORDER BY time
    </select>

    <!-- 查询卡片数据（正常设备和异常设备数量） -->
    <select id="selectCardData" resultMap="CarChargeMonitorCardDataResultMap">
        SELECT
        SUM(CASE WHEN monitor_status = '0' THEN 1 ELSE 0 END) AS normalDevice,
        SUM(CASE WHEN monitor_status != '0' THEN 1 ELSE 0 END) AS abnormalDevice
        FROM car_charge_monitor
        <where>
            <if test="reqVO.stationId != null">
                AND station_id = #{reqVO.stationId}
            </if>
            <if test="reqVO.timeRange != null and reqVO.timeRange.length == 2">
                AND monitor_time BETWEEN #{reqVO.timeRange[0]} AND #{reqVO.timeRange[1]}
            </if>
        </where>
    </select>


</mapper>