<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.stationresource.dal.mysql.stationresource.stationuser.StationUserMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <select id="getPage" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.stationuser.vo.StationUserRespVO">
        SELECT t.*
        FROM station_user t
        WHERE t.deleted = 0
        <if test="pageReqVO.username != null and pageReqVO.username != ''">
            AND t.username LIKE CONCAT('%', #{pageReqVO.username}, '%')
        </if>
        <if test="pageReqVO.password != null and pageReqVO.password != ''">
            AND t.password = #{pageReqVO.password}
        </if>
        <if test="pageReqVO.nickname != null and pageReqVO.nickname != ''">
            AND t.nickname LIKE CONCAT('%', #{pageReqVO.nickname}, '%')
        </if>
        <if test="pageReqVO.sex != null">
            AND t.sex = #{pageReqVO.sex}
        </if>
        <if test="pageReqVO.avatar != null and pageReqVO.avatar != ''">
            AND t.avatar = #{pageReqVO.avatar}
        </if>
        <if test="pageReqVO.phone != null and pageReqVO.phone != ''">
            AND t.phone = #{pageReqVO.phone}
        </if>
        <if test="pageReqVO.email != null and pageReqVO.email != ''">
            AND t.email = #{pageReqVO.email}
        </if>
        <if test="pageReqVO.status != null">
            AND t.status = #{pageReqVO.status}
        </if>
        <if test="pageReqVO.remark != null and pageReqVO.remark != ''">
            AND t.remark = #{pageReqVO.remark}
        </if>
        <if test="pageReqVO.reserve1 != null and pageReqVO.reserve1 != ''">
            AND t.reserve1 = #{pageReqVO.reserve1}
        </if>
        <if test="pageReqVO.reserve2 != null and pageReqVO.reserve2 != ''">
            AND t.reserve2 = #{pageReqVO.reserve2}
        </if>
        <if test="pageReqVO.creator != null and pageReqVO.creator != ''">
            AND t.creator = #{pageReqVO.creator}
        </if>
        <if test="pageReqVO.createTime != null and pageReqVO.createTime.size() == 2">
            AND t.create_time BETWEEN #{pageReqVO.createTime[0]} AND #{pageReqVO.createTime[1]}
        </if>
        <if test="pageReqVO.updater != null and pageReqVO.updater != ''">
            AND t.updater = #{pageReqVO.updater}
        </if>
        <if test="pageReqVO.updateTime != null and pageReqVO.updateTime.size() == 2">
            AND t.update_time BETWEEN #{pageReqVO.updateTime[0]} AND #{pageReqVO.updateTime[1]}
        </if>
        ORDER BY t.id DESC
    </select>

</mapper>
