<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.stationresource.dal.mysql.stationresource.rulecontrol.blackwhitelist.BlackWhiteListMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <!-- 统计卡片数据：生效数量、总拦截次数 -->
    <select id="selectCardData" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.rulecontrol.blackwhitelist.vo.ops.BlackWhiteListChartRespVO$CardDataVO">
        SELECT
            COUNT(CASE WHEN status = '已生效' THEN 1 END) AS enableListCount,
            IFNULL(SUM(intercept_count),0) AS totalInterceptCount
        FROM black_white_list
        WHERE deleted = 0
    </select>

    <!-- 饼图：按名单类型统计数量 -->
    <select id="selectTypePieList" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.rulecontrol.blackwhitelist.vo.ops.BlackWhiteListChartRespVO$TypePieVO">
        SELECT
            type AS name,
            COUNT(*) AS value
        FROM black_white_list
        WHERE deleted = 0
        GROUP BY type
    </select>
</mapper>
