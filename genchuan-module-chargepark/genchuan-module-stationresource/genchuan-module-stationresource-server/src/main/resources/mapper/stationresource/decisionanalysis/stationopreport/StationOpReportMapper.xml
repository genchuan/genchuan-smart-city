    <select id="selectOperateLine" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.decisionanalysis.stationopreport.vo.ops.StationOpReportChartRespVO$OperateLineVO">
        SELECT
            DATE_FORMAT(cpl.create_time, '%Y-%m-%d') AS date,
            IFNULL(SUM(cpl.today_order_count), 0) AS orderCount,
            IFNULL(SUM(cpl.today_income), 0) AS income
        FROM charge_park_link cpl
                 LEFT JOIN station_info s ON s.id = cpl.station_id
        WHERE cpl.deleted = 0
          AND s.deleted = 0
        GROUP BY DATE_FORMAT(cpl.create_time, '%Y-%m-%d')
        ORDER BY date ASC
    </select>

    <!-- 5. 柱状图 -->
    <select id="selectAreaBar" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.decisionanalysis.stationopreport.vo.ops.StationOpReportChartRespVO$AreaBarVO">
        SELECT
            a.name AS name,
            IFNULL(SUM(cpl.today_income), 0) AS income
        FROM station_info s
                 LEFT JOIN area_info a ON s.area_id = a.id
                 LEFT JOIN charge_park_link cpl ON s.id = cpl.station_id
        WHERE s.deleted = 0 AND a.deleted = 0
        GROUP BY a.id, a.name
        ORDER BY income DESC
    </select>

