    <!-- 1. 获取单条报表（统计） -->
    <select id="selectReportById" resultType="cn.iocoder.yudao.module.stationresource.dal.dataobject.stationresource.decisionanalysis.stationopreport.StationOpReportDO">
        SELECT
            1 AS id,
            '月报' AS reportType,
            DATE_FORMAT(NOW(), '%Y-%m') AS reportTime,
            (SELECT MIN(create_time) FROM station_info WHERE deleted = 0) AS startTime,
            (SELECT MAX(create_time) FROM station_info WHERE deleted = 0) AS endTime,
            'system' AS creator,
            NOW() AS createTime
    </select>

    <!-- 2. 分页查询（正确ID + 正确resultType） -->
    <select id="selectReportPage" resultType="cn.iocoder.yudao.module.stationresource.dal.dataobject.stationresource.decisionanalysis.stationopreport.StationOpReportDO">
        SELECT
            (@row := @row + 1) AS id,
            '月报' AS reportType,
            DATE_FORMAT(NOW(), '%Y-%m') AS reportTime,
            (SELECT MIN(create_time) FROM station_info WHERE deleted = 0) AS startTime,
            (SELECT MAX(create_time) FROM station_info WHERE deleted = 0) AS endTime,
            'system' AS creator,
            NOW() AS createTime
        WHERE 1=1
        <!-- 关键：时间筛选条件（前端传了就拼接） -->
        <if test="startTime != null">
            AND NOW() >= #{startTime}
        </if>
        <if test="endTime != null">
            AND NOW() &lt;= #{endTime}
        </if>
    </select>


