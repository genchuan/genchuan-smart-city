    <!-- 3. 卡片统计（真实业务表） -->
    <select id="selectCardData" resultType="cn.iocoder.yudao.module.stationresource.controller.admin.stationresource.decisionanalysis.stationopreport.vo.ops.StationOpReportChartRespVO$CardDataVO">
        SELECT
            IFNULL(SUM(cpl.today_order_count), 0) AS totalOrderCount,
            IFNULL(SUM(cpl.today_income), 0) AS totalIncome,
            IFNULL(
                            (SELECT COUNT(1) FROM parking_space_info WHERE real_status = '占用' AND deleted = 0)
                            / (SELECT COUNT(1) FROM parking_space_info WHERE deleted = 0) * 100, 0
                ) AS totalSpaceUseRate
        FROM station_info s
                 LEFT JOIN charge_park_link cpl ON s.id = cpl.station_id
        WHERE s.deleted = 0
    </select>

