# 使用明确版本的基础镜像（已修复已知漏洞）
FROM harbor.genchuan.cn/library/nginx:1.28.0-alpine3.21-slim

# 1. 基础安全配置
ENV LANG=zh_CN.UTF-8 \
    TZ=Asia/Shanghai \
    # 禁用非必要 Nginx 功能
    NGINX_DISABLE_ACCESS_LOG=true \
    NGINX_DISABLE_SERVER_TOKENS=true \
    # 设置非特权用户
    NGINX_USER=nginx \
    NGINX_GROUP=nginx

# 2. 最小化文件系统和权限
RUN set -eux; \
    # 创建非 root 用户和组
    addgroup -S $NGINX_GROUP && adduser -S -G $NGINX_GROUP $NGINX_USER; \
    # 清理 APK 缓存和临时文件
    rm -rf /var/cache/apk/* /tmp/*; \
    # 创建必要的目录并设置权限
    mkdir -p /var/www/dist && \
    chown -R $NGINX_USER:$NGINX_GROUP /var/www && \
    chmod -R 750 /var/www; \
    # 移除默认配置文件（由后续 COPY 覆盖）
    rm -f /etc/nginx/conf.d/default.conf

# 3. 复制应用文件（最小化文件权限）
COPY --chown=$NGINX_USER:$NGINX_GROUP dist/ /var/www/dist/
COPY --chmod=644 kubernetes/nginx/default.conf /etc/nginx/conf.d/default.conf

# 4. 健康检查（等保要求）
HEALTHCHECK --interval=30s --timeout=3s \
    CMD curl -f http://localhost/ || exit 1

# 5. 以非 root 用户运行
USER $NGINX_USER

# 6. 使用 exec 形式启动（避免 shell 注入）
CMD ["nginx", "-g", "daemon off;"]