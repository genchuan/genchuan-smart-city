    <!-- 根据名称和区域查询 -->
    <select id="selectByNameAndArea" resultType="cn.iocoder.yudao.module.evaluate.dal.dataobject.evalsystem.object.ObjectDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM eval_object
        WHERE deleted = 0
        AND name = #{name}
        AND area_code = #{areaCode}
        LIMIT 1
    </select>

    <!-- 根据ID查询详情 -->
    <select id="selectDetailById" resultType="cn.iocoder.yudao.module.evaluate.controller.admin.evalsystem.object.vo.ObjectRespVO">
        SELECT
        <include refid="Join_Column_List"/>
        FROM eval_object eo
        LEFT JOIN sys_area sa ON eo.area_code = sa.area_code AND sa.deleted = 0
        LEFT JOIN sys_object_type sot ON eo.object_type_id = sot.type_id AND sot.deleted = 0
        LEFT JOIN sys_user su ON eo.manager_id = su.user_id AND su.deleted = 0
        LEFT JOIN eval_related_object ero ON eo.related_id = ero.related_id AND ero.deleted = 0
        LEFT JOIN sys_status ss ON eo.status_id = ss.status_id AND ss.deleted = 0
        LEFT JOIN sys_user creator_user ON eo.create_by = creator_user.user_id AND creator_user.deleted = 0
        LEFT JOIN sys_user updater_user ON eo.update_by = updater_user.user_id AND updater_user.deleted = 0
        WHERE eo.deleted = 0
        AND eo.object_id = #{objectId}
    </select>
    <!-- 3. 联表查询详情（弹窗：完整关联数据，文档需求） -->
    <select id="selectJoinDetail" resultMap="ObjectRespVoResultMap">
        SELECT
            eo.*,
            sa.area_name,
            sot.name AS object_type_name,
            su1.user_name AS manager_name,
            su1.user_phone AS manager_phone,
            ss.name AS status_name,
            su2.user_name AS create_user_name,
            su3.user_name AS update_user_name
        FROM eval_object eo
                 LEFT JOIN sys_area sa ON eo.area_code = sa.area_code
                 LEFT JOIN sys_object_type sot ON eo.object_type_id = sot.type_id
                 LEFT JOIN sys_user su1 ON eo.manager_id = su1.user_id
                 LEFT JOIN sys_status ss ON eo.status_id = ss.status_id
                 LEFT JOIN sys_user su2 ON eo.create_by = su2.user_id
                 LEFT JOIN sys_user su3 ON eo.update_by = su3.user_id
        WHERE eo.id = #{id}
    </select>

    <!-- 4. 校验同一区域名称唯一性（新增/编辑，文档数据校验需求） -->
    <select id="countByNameAndAreaCode" resultType="java.lang.Long">
        SELECT COUNT(id)
        FROM eval_object
        WHERE name = #{name}
        AND area_code = #{areaCode}
        <if test="id != null">AND id != #{id}</if> <!-- 编辑时排除自身 -->
    </select>

    <!-- 5. 校验编码唯一性（新增/编辑，文档需求） -->
    <select id="countByCode" resultType="java.lang.Long">
        SELECT COUNT(id)
        FROM eval_object
        WHERE code = #{code}
        <if test="id != null">AND id != #{id}</if>
    </select>
</mapper>