<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.evaluate.dal.mysql.object.ObjectMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->
    <!-- 核心结果映射：评价对象VO，关联所有表字段，解决多表字段冲突 -->

    <!-- 结果映射：关联表字段→ObjectRespVo（文档要求的展示字段） -->
    <resultMap id="ObjectRespVoResultMap" type="cn.iocoder.yudao.module.evaluate.controller.admin.evalsystem.object.vo.ObjectRespVO">
        <!-- 主表eval_object字段 -->
        <id column="id" property="id"/>
        <result column="object_id" property="objectId"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="related_id" property="relatedId"/>
        <result column="change_log" property="changeLog"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>

        <!-- 关联表字段（文档核心展示需求） -->
        <result column="area_name" property="areaName"/> <!-- sys_area.area_name -->
        <result column="object_type_name" property="objectTypeName"/> <!-- sys_object_type.name -->
        <result column="manager_name" property="managerName"/> <!-- sys_user.user_name（负责人） -->
        <result column="manager_phone" property="managerPhone"/> <!-- sys_user.user_phone（负责人） -->
        <result column="status_name" property="statusName"/> <!-- sys_status.name -->
        <result column="create_user_name" property="createUserName"/> <!-- sys_user.user_name（创建人） -->
        <result column="update_user_name" property="updateUserName"/> <!-- sys_user.user_name（更新人） -->
    </resultMap>


    <!-- 基础列映射 -->
    <sql id="Base_Column_List">
        id, object_id, name, code, area_code, object_type_id, manager_id, related_id,
        status_id, create_by, biz_create_time, update_by, biz_update_time, change_log,
        ext_common1, ext_common2, ext_common3, ext_common4,
        creator, updater, deleted, tenant_id, create_time, update_time
    </sql>

    <!-- 联表查询列 -->
    <sql id="Join_Column_List">
        eo.object_id,
        eo.name,
        eo.code,
        eo.area_code,
        eo.object_type_id,
        eo.manager_id,
        eo.related_id,
        eo.status_id,
        eo.create_by,
        eo.biz_create_time,
        eo.update_by,
        eo.biz_update_time,
        eo.change_log,
        eo.ext_common1,
        eo.ext_common2,
        eo.ext_common3,
        eo.ext_common4,
        eo.create_time,
        eo.update_time,
        <!-- 区域信息 -->
        sa.area_name,
        <!-- 对象类型信息 -->
        sot.name as object_type_name,
        <!-- 负责人信息 -->
        su.user_name as manager_name,
        su.user_phone as manager_phone,
        <!-- 关联网格/部门信息 -->
        ero.related_name,
        <!-- 状态信息 -->
        ss.name as status_name,
        <!-- 创建人信息 -->
        creator_user.user_name as create_by_name,
        <!-- 更新人信息 -->
        updater_user.user_name as update_by_name
    </sql>
