<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.evaluate.dal.mysql.indexitem.IndexItemMapper">

    <!-- 根据分类ID集合批量查询指标项，按排序序号升序排列 -->
    <select id="selectListByCategoryIds" resultType="cn.iocoder.yudao.module.evaluate.dal.dataobject.evalsystem.indexitem.IndexItemDO">
        SELECT * FROM eval_index_item
        WHERE deleted = 0
          AND category_id IN
        <foreach collection="categoryIds" item="catId" open="(" separator="," close=")">
            #{catId}
        </foreach>
        ORDER BY sort_no ASC
    </select>

    <!-- 根据主键ID更新指标项权重（用于计算时自动归一化） -->
    <update id="updateItemWeightById">
        UPDATE eval_index_item
        SET weight = #{weight},
            update_time = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </update>

</mapper>