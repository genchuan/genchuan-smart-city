<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.evaluate.dal.mysql.commentstatistic.CommentStatisticMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
    -->

    <!-- 清空统计表所有数据 -->
    <delete id="deleteAll">
        DELETE FROM eval_comment_statistic
    </delete>

    <!-- 根据 itemId 和 objectId 从巡查巡检表动态统计数量 -->
    <select id="selectCountByItemIdAndObjectId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM eval_patrol_inspection
        WHERE deleted = 0
        <if test="itemId != null">
            AND item_id = #{itemId}
        </if>
        <if test="objectId != null">
            AND object_id = #{objectId}
        </if>
    </select>

    <!-- 根据 systemId、itemId 和 objectId 从巡查巡检表动态统计数量 -->
    <select id="selectCountBySystemIdAndItemIdAndObjectId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM eval_patrol_inspection
        WHERE deleted = 0
        <if test="systemId != null">
            AND system_id = #{systemId}
        </if>
        <if test="itemId != null">
            AND item_id = #{itemId}
        </if>
        <if test="objectId != null">
            AND object_id = #{objectId}
        </if>
    </select>

</mapper>