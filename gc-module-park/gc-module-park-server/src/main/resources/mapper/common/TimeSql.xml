<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.common.TimeSqlMapper">

    <!--
    通用时间筛选 SQL
    注意事项：
        1. 该通用 SQL 片段仅供现有代码兼容使用，请勿在新代码中新增引用
        2. startTime : 名称要一致。前端传入的筛选起始时间（包含此刻）。类型LocalDateTime
        3. endTime : 名称要一致。前端传入的筛选结束时间（包含此刻）。类型LocalDateTime
    参数说明：
      - search_time_col：要筛选的时间字段
    使用方式：
        <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.TimeSqlMapper.searchByStartTimeEndTime">
            <property name="search_time_col" value="stat_time"/>
        </include>
    原始呈现：
    <if test="startTime != null and endTime != null">
        AND stat_time BETWEEN #{startTime} AND #{endTime}
    </if>
    <if test="startTime != null and endTime == null">
        AND stat_time &gt;= #{startTime}
    </if>
    <if test="startTime == null and endTime != null">
        AND stat_time &lt;= #{endTime}
    </if>
-->
    <sql id="searchByStartTimeEndTime">
            <choose>
                <when test="startTime != null and endTime != null">
                    ${search_time_col} BETWEEN #{startTime} AND #{endTime}
                </when>
                <when test="startTime != null">
                    ${search_time_col} &gt;= #{startTime}
                </when>
                <when test="endTime != null">
                    ${search_time_col} &lt;= #{endTime}
                </when>
                <otherwise>
                    1=1
                </otherwise>
            </choose>
    </sql>
</mapper>
