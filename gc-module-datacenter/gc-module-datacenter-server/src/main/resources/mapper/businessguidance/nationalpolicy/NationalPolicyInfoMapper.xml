<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.datacenter.dal.mysql.businessguidance.nationalpolicy.NationalPolicyInfoMapper">

    <resultMap id="NationalPolicyInfoResult" type="cn.iocoder.yudao.module.datacenter.dal.dataobject.businessguidance.nationalpolicy.NationalPolicyInfoDO">
        <id column="id" property="id" />
        <result column="policy_id" property="policyId" />
        <result column="policy_no" property="policyNo" />
        <result column="policy_name" property="policyName" />
        <result column="policy_type" property="policyType" />
        <result column="issue_dept" property="issueDept" />
        <result column="issue_time" property="issueTime" />
        <result column="effective_time" property="effectiveTime" />
        <result column="expire_time" property="expireTime" />
        <result column="policy_file_path" property="policyFilePath" />
        <result column="policy_abstract" property="policyAbstract" />
        <result column="policy_status" property="policyStatus" />
        <result column="upload_user_id" property="uploadUserId" />
        <result column="upload_time" property="uploadTime" />
        <result column="update_user_id" property="updateUserId" />
        <result column="update_time" property="updateTime" />
        <result column="extend_category" property="extendCategory" />
        <!-- 系统字段 -->
        <result column="creator" property="creator" />
        <result column="updater" property="updater" />
        <result column="deleted" property="deleted" />
        <result column="tenant_id" property="tenantId" />
        <result column="create_time_sys" property="createTimeSys" />
        <result column="update_time_sys" property="updateTimeSys" />
    </resultMap>

    <!-- 查询政策统计信息 -->
    <select id="selectPolicyStatistics" resultType="java.util.Map">
        SELECT
            policy_type as type,
            COUNT(*) as count,
            policy_status as status
        FROM gc_national_policy_info
        WHERE deleted = 0
        GROUP BY policy_type, policy_status
    </select>

    <!-- 查询政策时间线 -->
    <select id="selectPolicyTimeline" resultMap="NationalPolicyInfoResult">
        SELECT * FROM gc_national_policy_info
        WHERE deleted = 0
          AND policy_status IN ('有效', '未生效')
        ORDER BY issue_time DESC
            LIMIT #{limit}
    </select>

</mapper>