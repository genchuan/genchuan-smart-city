    <!--
        方法：stat
        描述：根据时间范围和区域统计缴费信息。
              支持省/市/县/街道/社区级别筛选，统计区域及其下级所有子区域的缴费数据。
        参数：
            - startTime        : 开始时间（LocalDateTime）
            - endTime          : 结束时间（LocalDateTime）
            - regionFullCode   : 筛选的区域码（12位），可为省/市/县/街道/社区
            - statCycle        : 统计周期，如 day/month/year
        返回值：
            - StatParkPayDO 对象，包含以下字段：
                regionFullCode   : 返回筛选的区域码
                regionName       : 返回筛选区域名称（省/市/县/街道/社区级别）
                totalOrderCount  : 总订单数
                totalPayAmount   : 总缴费金额
                paySuccessRate   : 支付成功率（百分比）
                wechatRatio      : 微信支付占比（百分比）
                alipayRatio      : 支付宝支付占比（百分比）
                cardRatio        : 银行卡支付占比（百分比）
    -->
    <!-- 根据时间和区域生成缴费统计 -->
    <select id="stat" resultType="cn.iocoder.yudao.module.industry.dal.dataobject.park.pay.statparkpay.StatParkPayDO" parameterType="map">
        SELECT
        min(area.name) AS regionName,
        #{regionFullCode} AS regionFullCode,  <!-- 新增 -->
        #{statCycle} AS statCycle,
        COUNT(*) AS totalOrderCount,
        SUM(pay.actual_pay_amount) AS totalPayAmount,
        SUM(CASE WHEN pay.pay_status = '支付成功' THEN 1 ELSE 0 END) / COUNT(*) * 100 AS paySuccessRate,
        SUM(CASE WHEN pay.pay_method = '微信支付' THEN 1 ELSE 0 END) / COUNT(*) * 100 AS wechatRatio,
        SUM(CASE WHEN pay.pay_method = '支付宝支付' THEN 1 ELSE 0 END) / COUNT(*) * 100 AS alipayRatio,
        SUM(CASE WHEN pay.pay_method = '银行卡支付' THEN 1 ELSE 0 END) / COUNT(*) * 100 AS cardRatio
        FROM biz_park_pay pay
        LEFT JOIN sys_area area
        ON #{regionFullCode} COLLATE utf8mb4_unicode_ci = area.full_code COLLATE utf8mb4_unicode_ci

        WHERE pay.create_time BETWEEN #{startTime} AND #{endTime}
        <if test="regionFullCode != null and regionFullCode != ''">
          and
            <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionFullCode">
                <property name="areaColumn" value="pay.region_full_code"/>
            </include>
        </if>
        AND pay.deleted = 0

    </select>
