    <!--
    方法：getRegionPayRatio
    描述：统计指定时间范围内的缴费金额及占比，按指定行政区划层级聚合。
          支持省/市/县/街道/社区级别统计，返回各下级区域的缴费数据。
    参数：
        - startTime                     : 开始时间（LocalDateTime）
        - endTime                       : 结束时间（LocalDateTime）
        - regionFullCode                 : 筛选区域码（12位），可为省/市/县/街道/社区
        - regionCodeChildEffectiveLength : 下级区域码有效长度，例如：
                                           2=省级, 4=市级, 6=县级, 9=街道, 12=社区
        - regionCodeChildLevel           : 下级区域的层级（与 sys_area.level 对应）
    返回值：
        - JSON 字符串，数组格式，每个元素包含：
            regionFullCode : 下级区域完整区域码（12位）
            regionName     : 下级区域名称
            payAmount      : 下级区域缴费总额
            ratio          : 下级区域缴费金额占总额比例（百分比）
-->
    <select id="getRegionPayRatio" resultType="java.lang.String">
        SELECT
        JSON_ARRAYAGG(
        JSON_OBJECT(
        'regionFullCode', RPAD(t.region_group_code, 12, '0'),
        'regionName', sa.name,
        'payAmount', t.region_pay_amount,
        'ratio', ROUND(t.region_pay_amount / t.total_pay_amount * 100, 2)
        )
        )
        FROM (
        SELECT
        LEFT(region_full_code, #{regionCodeChildEffectiveLength}) AS region_group_code,
        SUM(actual_pay_amount) AS region_pay_amount,
        SUM(SUM(actual_pay_amount)) OVER () AS total_pay_amount
        FROM biz_park_pay
        WHERE create_time BETWEEN #{startTime} AND #{endTime}
        AND pay_status = '支付成功'
        AND deleted = 0
        <if test="regionFullCode != null and regionFullCode != ''">
            AND
            <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionFullCode">
                <property name="areaColumn" value="region_full_code"/>
            </include>
        </if>
        GROUP BY LEFT(region_full_code, #{regionCodeChildEffectiveLength})
        ) t
        LEFT JOIN sys_area sa
        ON LEFT(sa.full_code, #{regionCodeChildEffectiveLength})
        COLLATE utf8mb4_unicode_ci
        = t.region_group_code
        COLLATE utf8mb4_unicode_ci
        AND sa.level = #{regionCodeChildLevel}
        AND sa.deleted = B'0'
    </select>
    <select id="selectAreaByFullCode" resultType="java.lang.String">
        select name
        from sys_area
        where full_code =#{region_full_code}
    </select>


