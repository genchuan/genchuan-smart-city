<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.parkmng.dpzl.datamap.ParkDataMapMapper">

    <resultMap id="DataMapResult" type="cn.iocoder.yudao.module.industry.controller.admin.parkmng.dpzl.datamap.vo.ParkDataMapRespVO">
        <id column="id" property="id" />
        <result column="park_id" property="parkId" />
        <result column="park_name" property="parkName" />
        <result column="total_space" property="totalSpace" />
        <result column="free_space" property="freeSpace" />
        <result column="space_status" property="spaceStatus" />
        <result column="coord_x" property="coordX" />
        <result column="coord_y" property="coordY" />
        <result column="park_type" property="parkType" />
        <result column="space_location" property="spaceLocation" />
        <result column="fault_flag" property="faultFlag" />
        <result column="surround_free_space" property="surroundFreeSpace" />
        <result column="to_evac_vehicle" property="toEvacVehicle" />
    </resultMap>

    <sql id="selectColumns">
        SELECT
            res.id,
            res.park_id,
            res.park_name,
            res.total_space,
            real_time.free_space,
            real_time.space_status,
            res.coord_x,
            res.coord_y,
            res.park_type,
            res.space_location,
            real_time.fault_flag,
            real_time.surround_free_space,
            real_time.to_evac_vehicle
        FROM biz_park_res res
                 LEFT JOIN biz_park_real_time real_time ON res.park_id = real_time.park_id
            AND res.tenant_id = real_time.tenant_id
            AND res.deleted = real_time.deleted
    </sql>

    <select id="selectDataMapList" parameterType="cn.iocoder.yudao.module.industry.controller.admin.parkmng.dpzl.datamap.vo.ParkDataMapQueryReqVO" resultMap="DataMapResult">
        <include refid="selectColumns"/>
        <where>
            res.deleted = 0
            <if test="parkId != null">
                AND res.park_id = #{parkId}
            </if>
            <if test="parkName != null and parkName != ''">
                AND res.park_name LIKE CONCAT('%', #{parkName}, '%')
            </if>
            <if test="parkType != null and parkType != ''">
                AND res.park_type = #{parkType}
            </if>
            <if test="spaceStatus != null and spaceStatus != ''">
                AND real_time.space_status = #{spaceStatus}
            </if>
            <if test="faultFlag != null">
                AND real_time.fault_flag = #{faultFlag}
            </if>
        </where>
        ORDER BY res.park_id
    </select>

    <select id="selectDataMapById" parameterType="Long" resultMap="DataMapResult">
        <include refid="selectColumns"/>
        WHERE res.id = #{id} AND res.deleted = 0
    </select>

</mapper>