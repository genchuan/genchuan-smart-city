<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.lawenf.dashboard.global.overview.LawOverviewMapper">

    <select id="getLawOverview"
            parameterType="map"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.overview.vo.LawOverviewRespVO">

        SELECT
            -- 1. 执法案件总数
            IFNULL(SUM(c.total_case_count), 0) AS totalCaseCount,
            -- 2. 今日新增案件数
            IFNULL(SUM(c.new_case_today), 0) AS newCaseToday,
            -- 3. 案件办结率
            IFNULL(AVG(c.case_complete_rate), 0) AS caseCompleteRate,

            -- 4. 执法人员总数
            (SELECT COUNT(1)
            FROM biz_law_enf_staff u
            <where>
                <if test="regionShortCode != null and regionShortCode != ''">
                    AND
                    <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionShortCode">
                        <property name="areaColumn" value="LEFT(u.region_full_code,6)"/>
                    </include>
                </if>
            </where>
            ) AS totalStaffCount,

            -- 5. 执法设备在线数
            (SELECT IFNULL(SUM(d.online_status), 0)
            FROM biz_law_enf_device d
            <where>
                d.is_delete = 0
                <if test="regionShortCode != null and regionShortCode != ''">
                    AND
                    <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionShortCode">
                        <property name="areaColumn" value="LEFT(d.region_full_code,6)"/>
                    </include>
                </if>
            </where>
            ) AS onlineDeviceCount

        FROM stat_law_enf_case c
        <where>
            <if test="regionShortCode != null and regionShortCode != ''">
                and c.region_short_code = #{regionShortCode}
            </if>
            <if test="startTime != null">
                AND c.stat_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND c.stat_time &lt;= #{endTime}
            </if>
        </where>

    </select>
    <!--
     查询执法相关数据中实际出现过的行政区列表
     用于前端行政区筛选（省/市/县级联）

     查询逻辑说明：
     1. 从案件、人员、设备三张表中提取 region_short_code / region_full_code 的前 6 位
        作为区域编码来源，并去重。
     2. 使用统一的 utf8mb4_unicode_ci 排序规则避免跨表字符集冲突。
     3. 根据得到的编码到 sys_area 中匹配行政区名称。
     4. 最终按地区码升序返回。
 -->
    <select id="getLawOverviewArea"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.overview.vo.LawOverviewArea">

        SELECT sa.short_code AS regionShortCode,
               sa.name AS regionName
        FROM sys_area sa
        WHERE sa.short_code COLLATE utf8mb4_unicode_ci IN
              (
                  -- 案件表中的地区编码
                  SELECT DISTINCT c.region_short_code COLLATE utf8mb4_unicode_ci
                  FROM stat_law_enf_case c
                  WHERE c.region_short_code IS NOT NULL
                    AND c.region_short_code != ''

                  UNION

                  -- 执法人员表中的地区编码（取前 6 位）
                  SELECT DISTINCT LEFT(u.region_full_code, 6) COLLATE utf8mb4_unicode_ci
                  FROM biz_law_enf_staff u
                  WHERE u.region_full_code IS NOT NULL
                    AND u.region_full_code != ''

                  UNION

                  -- 执法设备表中的地区编码（取前 6 位）
                  SELECT DISTINCT LEFT(d.region_full_code, 6) COLLATE utf8mb4_unicode_ci
                  FROM biz_law_enf_device d
                  WHERE d.region_full_code IS NOT NULL
                    AND d.region_full_code != ''
              )
        ORDER BY sa.short_code ASC;

    </select>
    <!--
        查询行政区域列表（名称和地区码）

        功能说明：
        1. 若未传入 regionShortCode，则返回所有省级行政区（XX0000）。
        2. 若传入省级编码（regionShortCode 以 '0000' 结尾），则返回该省下的所有市级行政区（XXXX00）。
        3. 若传入市级编码（regionShortCode 以 '00' 结尾），则返回该市下的所有县级行政区（XXXXXX）。
        4. 若传入县级编码，则返回该县本身。

        参数：
        - regionShortCode：可选，父级行政区编码，用于获取下级行政区。

        返回：
        - regionShortCode：行政区编码
        - regionName：行政区名称

        用途：
        - 前端行政区级联选择
        - 数据筛选等场景
    -->
    <select id="getAllArea"
            parameterType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.overview.vo.AreaReqVO"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.overview.vo.AreaRespVO">

        SELECT
        sa.short_code AS regionShortCode,
        sa.name AS regionName
        FROM sys_area sa
        <where>
            <if test="regionShortCode == null or regionShortCode == ''">
                <!-- 未传参数，获取所有省级行政区（XX0000） -->
                AND sa.short_code LIKE '__0000'
            </if>
            <if test="regionShortCode != null and regionShortCode != ''">
                <!-- 传了父级编码，则获取下级行政区 -->
                <choose>
                    <when test="regionShortCode.endsWith('0000')">
                        <!-- 父级是省级，获取市级（XXXX00） -->
                        AND sa.short_code LIKE CONCAT(SUBSTRING(#{regionShortCode},1,2),'__00')
                        AND sa.short_code != #{regionShortCode}
                    </when>
                    <when test="regionShortCode.endsWith('00')">
                        <!-- 父级是市级，获取县级（XXXXXX） -->
                        AND sa.short_code LIKE CONCAT(SUBSTRING(#{regionShortCode},1,4),'__')
                        AND sa.short_code != #{regionShortCode}
                    </when>
                    <otherwise>
                        AND sa.short_code = #{regionShortCode}  <!-- 直接匹配县级 -->
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY sa.short_code ASC
    </select>



</mapper>
