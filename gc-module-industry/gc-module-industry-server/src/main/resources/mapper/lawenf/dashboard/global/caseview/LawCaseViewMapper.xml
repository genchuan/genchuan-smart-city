<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.lawenf.dashboard.global.caseview.LawCaseViewMapper">

    <sql id="lawCaseViewFilter">
        <!--
            公共过滤条件 SQL 片段
            用途：执法案件统计查询的统一筛选条件
            参数说明：
                caseType      - 按案件类型筛选（对应字段 case_type），如 "违法建设"
                caseSource    - 按案件来源筛选（对应字段 case_source），如 "热线举报"
                progressStage - 按办理进度阶段筛选（对应字段 progress_stage），如 "调查取证"
                startTime     - 起始时间筛选（对应字段 stat_time），包含该日期
                endTime       - 结束时间筛选（对应字段 stat_time），包含该日期
            使用方式：
                在具体查询中通过 <include refid="lawCaseViewFilter"/> 引用
                可用于按案件类型/来源/进度分布及超期未办结案件总数统计
            特点：
                - 参数为空或 null 时，不加筛选条件
                - 支持按时间周期筛选
                - 便于扩展新的筛选条件
        -->
        <if test="caseType != null and caseType != ''">
            AND case_type = #{caseType}
        </if>
        <if test="caseSource != null and caseSource != ''">
            AND case_source = #{caseSource}
        </if>
        <if test="progressStage != null and progressStage != ''">
            AND progress_stage = #{progressStage}
        </if>
        <if test="startTime != null">
            AND stat_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND stat_time &lt;= #{endTime}
        </if>
    </sql>

    <!-- 按案件类型分布 -->
    <select id="selectCaseTypeCount"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.caseview.vo.LawCaseViewRespVO$CaseTypeCount">
        SELECT
        case_type AS caseType,
        SUM(case_count) AS caseCount
        FROM stat_law_enf_case
        WHERE 1=1

        <include refid="lawCaseViewFilter"/>
        GROUP BY case_type
    </select>

    <!-- 按案件来源分布 -->
    <select id="selectCaseSourceCount"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.caseview.vo.LawCaseViewRespVO$CaseSourceCount">
        SELECT
        case_source AS caseSource,
        SUM(case_count) AS caseCount
        FROM stat_law_enf_case
        WHERE 1=1

        <include refid="lawCaseViewFilter"/>
        GROUP BY case_source
    </select>

    <!-- 按进度阶段分布 -->
    <select id="selectProgressStageCount"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.caseview.vo.LawCaseViewRespVO$ProgressStageCount">
        SELECT
        progress_stage AS progressStage,
        SUM(case_count) AS caseCount
        FROM stat_law_enf_case
        WHERE 1=1

        <include refid="lawCaseViewFilter"/>
        GROUP BY progress_stage
    </select>

    <!-- 超期未办结案件总数 -->
    <select id="selectOverdueCaseCount" resultType="java.lang.Integer">
        SELECT SUM(overdue_case_count)
        FROM stat_law_enf_case
        WHERE 1=1

        <include refid="lawCaseViewFilter"/>
    </select>

</mapper>
