    <!-- ===============================
1. 平均案件办结时长 - 近7天趋势
=============================== -->
    <select id="getAvgCaseHandleTimeTrendVOList"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.coremetrics.vo.TreatTrendVO">
        SELECT
        DATE(stat_time) AS date,                <!-- 日期字段 -->
        IFNULL(AVG(avg_case_handle_time), 0) AS value
        FROM stat_law_enf_case
        <where>
            stat_time >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)
        </where>
        GROUP BY DATE(stat_time)
        ORDER BY DATE(stat_time) ASC
    </select>

    <!-- ===============================
    2. 执法合规率 - 近7天趋势
    =============================== -->
    <select id="getLawComplianceRateTrendVOList"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.lawenf.dashboard.global.coremetrics.vo.TreatTrendVO">
        SELECT
        DATE(stat_time) AS date,
        IFNULL(AVG(law_compliance_rate), 0) AS value
        FROM stat_law_enf_std
        <where>
            stat_time >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)
        </where>
        GROUP BY DATE(stat_time)
        ORDER BY DATE(stat_time) ASC
    </select>

