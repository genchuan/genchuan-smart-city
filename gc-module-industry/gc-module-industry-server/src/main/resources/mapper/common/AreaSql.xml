<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper">
    <!--
        按省/市/县三级行政区划筛选的通用 SQL 片段。
        注意事项：
            1. 该通用 SQL 片段仅供现有代码兼容使用，请勿在新代码中新增引用
            2. regionShortCode : 名称要一致。前端传入的行政区划码（6位），用于搜索和判断省/市/县级。
        参数说明：
          - areaColumn : 数据表中的行政区划编码字段(6位)（例如 dist_region、region_code 等）。
        使用方式：
            <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionShortCode">
                <property name="areaColumn" value="LEFT(region_full_code,6)"/>
            </include>
    -->
    <!-- 按省/市/县三级行政区划筛选的通用 SQL 片段 -->
    <sql id="likeByRegionShortCode">
        <choose>
            <when test="regionShortCode != null and regionShortCode != '' and regionShortCode.endsWith('0000')">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionShortCode}, 2), '%')
            </when>
            <when test="regionShortCode != null and regionShortCode != '' and regionShortCode.endsWith('00') ">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionShortCode}, 4), '%')
            </when>
            <when test="regionShortCode != null and regionShortCode != ''">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionShortCode}, 6), '%')
            </when>
            <!-- 新增：地区码为空时不加条件，返回全量 -->
            <otherwise>
                1=1
            </otherwise>
        </choose>
    </sql>


    <!--
    按12位地区码行政区划筛选的通用 SQL 片段。
    注意事项：
        1. 该通用 SQL 片段仅供现有代码兼容使用，请勿在新代码中新增引用
        2. regionFullCode : 名称要一致。前端传入的行政区划码（12位），用于搜索和判断省/市/县级/街道/社区。
        3.这个没有 筛选 是 没有 and的！！！！！！！
    参数说明：
      - areaColumn : 数据表中的行政区划编码字段(6位或12位都行，编码必须是完整的、末位不为 0)（例如 dist_region、region_code 等）。
    使用方式：
        <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByRegionFullCode">
            <property name="areaColumn" value="region_full_code"/>
        </include>
    -->
    <!-- 按省/市/县/街道/社区五级行政区划筛选的通用 SQL 片段 -->
    <sql id="likeByRegionFullCode">
        <choose>
            <!-- 省级 -->
            <when test="regionFullCode != null and regionFullCode != '' and regionFullCode.length() == 12
             and regionFullCode.endsWith('0000000000')">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionFullCode}, 2), '%')
            </when>
            <!-- 市级 -->
            <when test="regionFullCode != null and regionFullCode != '' and regionFullCode.length() == 12
             and regionFullCode.endsWith('00000000') ">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionFullCode}, 4), '%')
            </when>
            <!-- 县级 -->
            <when test="regionFullCode != null and regionFullCode != '' and regionFullCode.length() == 12
             and regionFullCode.endsWith('000000') ">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionFullCode}, 6), '%')
            </when>
            <!-- 街道级 -->
            <when test="regionFullCode != null and regionFullCode != '' and regionFullCode.length() == 12
             and regionFullCode.endsWith('000') ">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionFullCode}, 9), '%')
            </when>
            <!-- 社区级 -->
            <when test="regionFullCode != null and regionFullCode != '' and regionFullCode.length() == 12">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionFullCode}, 12), '%')
            </when>
            <!-- 新增：地区码为空时不加条件，返回全量 -->
            <otherwise>
                1=1
            </otherwise>
        </choose>
    </sql>

</mapper>
