<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper">
    <!--
        按省/市/县三级行政区划筛选的通用 SQL 片段。
        注意事项：
            1. 该通用 SQL 片段仅供现有代码兼容使用，请勿在新代码中新增引用
            2. regionShortCode : 名称要一致。前端传入的行政区划码（6位），用于搜索和判断省/市/县级。
        参数说明：
          - areaColumn : 数据表中的行政区划编码字段(6位)（例如 dist_region、region_code 等）。
        使用方式：
            <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.AreaSqlMapper.likeByAreaLevel">
                <property name="areaColumn" value="LEFT(d.region_full_code,6)"/>
            </include>
    -->
    <!-- 按省/市/县三级行政区划筛选的通用 SQL 片段 -->
    <sql id="likeByAreaLevel">
        <choose>
            <!-- 新增：地区码为空时不加条件，返回全量 -->
            <when test="regionShortCode == null or regionShortCode == ''">
                1=1
            </when>
            <when test="regionShortCode != null and regionShortCode.endsWith('0000')">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionShortCode}, 2), '%')
            </when>
            <when test="regionShortCode != null and regionShortCode.endsWith('00') and !regionShortCode.endsWith('0000')">
                ${areaColumn} LIKE CONCAT(LEFT(#{regionShortCode}, 4), '%')
            </when>
            <otherwise>
                ${areaColumn} = #{regionShortCode}
            </otherwise>
        </choose>
    </sql>

</mapper>
