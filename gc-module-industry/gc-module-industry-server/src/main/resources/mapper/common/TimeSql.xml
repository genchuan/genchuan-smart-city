<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.common.TimeSqlMapper">

    <!--
    通用时间筛选 SQL
    注意事项：
        1. 该通用 SQL 片段仅供现有代码兼容使用，请勿在新代码中新增引用
        2. startDate : 名称要一致。前端传入的筛选起始时间（包含此刻）。类型LocalDateTime
        3. endDate : 名称要一致。前端传入的筛选结束时间（包含此刻）。类型LocalDateTime
    参数说明：
      - stat_time_col：要筛选的时间字段
    使用方式：
        <include refid="cn.iocoder.yudao.module.industry.dal.mysql.common.TimeSqlMapper.statTimeSearch">
            <property name="stat_time_col" value="stat_time"/>
        </include>
-->
    <sql id="statTimeSearch">

            <if test="startDate != null">
                AND ${stat_time_col} &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND ${stat_time_col} &lt;= #{endDate}
            </if>

    </sql>

</mapper>
