    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询紧急告警数量 -->
    <select id="getEmergencyCount" resultType="java.lang.Integer">
        -- 方法说明：获取指定大类和小类的市政设施紧急故障总数
        -- 逻辑：
        -- 1. 按 comp_major_id + comp_minor_id 分组，每组取最新 update_time 的一条记录
        -- 2. 对每组最新记录的 damaged_comp_count 求和
        -- 3. 如果求和结果为 NULL，则返回 0

        -- 外层查询：对每组最新记录的 damaged_comp_count 求和，如果结果为 NULL 则返回 0
        SELECT IFNULL(SUM(damaged_comp_count), 0) AS totalDamaged
        FROM (
                 -- 中层查询：只保留每个大类+小类的最新一条记录
                 SELECT damaged_comp_count
                 FROM (
                          -- 内层查询：给每个大类+小类的记录生成行号 rn，按更新时间倒序排列
                          SELECT *,
                                 ROW_NUMBER() OVER (
                                     PARTITION BY comp_major_id, comp_minor_id  -- 按大类+小类分组
                                     ORDER BY update_time DESC                  -- 最新更新时间排在最前面
                                     ) AS rn
                          FROM stat_mng_comp_rpt
                            <where>
                                <!-- 紧急：大类 IN emergencyMajorList -->
                                <if test="emergencyMajorList != null and emergencyMajorList.size() > 0">
                                    comp_major_id IN
                                    <foreach collection="emergencyMajorList" item="mj" open="(" close=")" separator=",">
                                        #{mj}
                                    </foreach>
                                </if>
                                <!-- 紧急：小类 IN emergencyMinorList -->
                                <if test="emergencyMinorList != null and emergencyMinorList.size() > 0">
                                    AND comp_minor_id IN
                                    <foreach collection="emergencyMinorList" item="mi" open="(" close=")" separator=",">
                                        #{mi}
                                    </foreach>
                                </if>
                            </where>
                      ) t
                      -- 只取每组大类+小类最新的一条（行号 rn = 1）
                 WHERE t.rn = 1
             ) latest
    </select>


    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询一般告警数量 -->
    <select id="getNormalCount" resultType="java.lang.Integer">
        -- 方法说明：获取指定大类和小类的市政设施紧急故障总数
        -- 逻辑：
        -- 1. 按 comp_major_id + comp_minor_id 分组，每组取最新 update_time 的一条记录
        -- 2. 对每组最新记录的 damaged_comp_count 求和
        -- 3. 如果求和结果为 NULL，则返回 0

        -- 外层查询：对每组最新记录的 damaged_comp_count 求和，如果结果为 NULL 则返回 0
        SELECT IFNULL(SUM(damaged_comp_count), 0) AS totalDamaged
        FROM (
                 -- 中层查询：只保留每个大类+小类的最新一条记录
                 SELECT damaged_comp_count
                 FROM (
                          -- 内层查询：给每个大类+小类的记录生成行号 rn，按更新时间倒序排列
                          SELECT *,
                                 ROW_NUMBER() OVER (
                                     PARTITION BY comp_major_id, comp_minor_id  -- 按大类+小类分组
                                     ORDER BY update_time DESC                  -- 最新更新时间排在最前面
                                     ) AS rn
                          FROM stat_mng_comp_rpt
                            <where>
                                <!-- 紧急：大类 IN emergencyMajorList -->
                                <if test="emergencyMajorList != null and emergencyMajorList.size() > 0">
                                    comp_major_id IN
                                    <foreach collection="emergencyMajorList" item="mj" open="(" close=")" separator=",">
                                        #{mj}
                                    </foreach>
                                </if>
                                <!-- 紧急：小类 IN emergencyMinorList -->
                                <if test="emergencyMinorList != null and emergencyMinorList.size() > 0">
                                    AND comp_minor_id not IN
                                    <foreach collection="emergencyMinorList" item="mi" open="(" close=")" separator=",">
                                        #{mi}
                                    </foreach>
                                </if>
                            </where>
                      ) t
                      -- 只取每组大类+小类最新的一条（行号 rn = 1）
                 WHERE t.rn = 1
             ) latest
    </select>

    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询故障总数 -->
    <select id="getTotalFault" resultType="java.lang.Integer">
        -- 方法说明：获取指定大类下所有小类的故障总数，每个小类只取最新一条记录
        SELECT IFNULL(SUM(damaged_comp_count), 0) AS totalFault
        FROM (
                 SELECT damaged_comp_count
                 FROM (
                          SELECT *,
                                 ROW_NUMBER() OVER (
                                     PARTITION BY comp_major_id, comp_minor_id  -- 按大类+小类分组
                                     ORDER BY update_time DESC                  -- 每组最新记录排在前面
                                     ) AS rn
                          FROM stat_mng_comp_rpt
                            <where>
                                <!-- 紧急：大类 IN emergencyMajorList -->
                                <if test="emergencyMajorList != null and emergencyMajorList.size() > 0">
                                    comp_major_id IN
                                    <foreach collection="emergencyMajorList" item="mj" open="(" close=")" separator=",">
                                        #{mj}
                                    </foreach>
                                </if>
                            </where>
                      ) t
                 WHERE t.rn = 1  -- 只取每组最新一条
             ) latest
    </select>

    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询已处理数量 -->
    <select id="getHandledCount" resultType="java.lang.Integer">
        select sum(update_comp_count)
        from stat_mng_comp_rpt
        <where>
            <!-- 市政设施：大类 IN muniFacMajorList -->
            <if test="muniFacMajorList != null and muniFacMajorList.size() > 0">
                comp_major_id IN
                <foreach collection="muniFacMajorList" item="mj" open="(" close=")" separator=",">
                    #{mj}
                </foreach>
            </if>
        </where>
    </select>

    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询处理率（已处理数 / 故障总数） -->
    <select id="getHandlingRate" resultType="java.math.BigDecimal">
        SELECT
            IFNULL(
                    AVG(
                            CASE
                                WHEN total_comp_count = 0 OR total_comp_count IS NULL THEN 0
                                ELSE (update_comp_count / total_comp_count)*100
                                END
                        ),
                    0
                ) AS handlingRate
        FROM stat_mng_comp_rpt
        <where>
            <!-- 市政设施：大类 IN muniFacMajorList -->
            <if test="muniFacMajorList != null and muniFacMajorList.size() > 0">
                comp_major_id IN
                <foreach collection="muniFacMajorList" item="mj" open="(" close=")" separator=",">
                    #{mj}
                </foreach>
            </if>
        </where>
    </select>

    <!-- 1.2.1. 市政设施专题 - 市政设施概览数据：查询超时数量 -->
    <select id="getTimeoutCount" resultType="java.lang.Integer">
        select sum(damaged_comp_count)
        from stat_mng_comp_rpt
        <where>
            <!-- 市政设施：大类 IN muniFacMajorList -->
            <if test="muniFacMajorList != null and muniFacMajorList.size() > 0">
                comp_major_id IN
                <foreach collection="muniFacMajorList" item="mj" open="(" close=")" separator=",">
                    #{mj}
                </foreach>
            </if>
        </where>
    </select>

