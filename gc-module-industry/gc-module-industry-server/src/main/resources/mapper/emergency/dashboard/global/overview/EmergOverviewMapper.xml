<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.emergency.dashboard.global.overview.EmergOverviewMapper">

    <!--
        按省/市/县三级行政区划筛选的通用 SQL 片段。
        参数说明：
          - searchAreaCode : 前端传入的行政区划码（6位），用于搜索和判断省/市/县级。
          - areaColumn : 数据表中的行政区划编码字段(6位)（例如 dist_region、region_code 等）。
        使用方式：
                    <include refid="likeByRegionShortCode">
                        <property name="areaColumn" value="LEFT(dist_region,6)"/>
                        <property name="searchAreaCode" value="#{regionShortCode}"/>
                    </include>
    -->
    <!-- 按省/市/县三级行政区划筛选的通用 SQL 片段 -->
    <sql id="likeByRegionShortCode">
        <choose>
            <when test="regionShortCode != null and regionShortCode.endsWith('0000')">
                ${areaColumn} LIKE CONCAT(LEFT(${searchAreaCode},2),'%')
            </when>
            <when test="regionShortCode != null and regionShortCode.endsWith('00') and !regionShortCode.endsWith('0000')">
                ${areaColumn} LIKE CONCAT(LEFT(${searchAreaCode},4),'%')
            </when>
            <otherwise>
                ${areaColumn} = ${searchAreaCode}
            </otherwise>
        </choose>
    </sql>

    <select id="getEmergOverview"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.emergency.dashboard.global.overview.vo.EmergOverviewRespVO">
        SELECT
        evt.total_evt_count,
        evt.handl_count,
        evt.completed_count,
        res.total_res_count,
        risk.high_risk_count,
        area.region_cover_count,
        NULLIF(
        GREATEST(
                IFNULL(evt.max_stat_time, '0001-01-01'),
                IFNULL(res.max_res_time, '0001-01-01'),
                IFNULL(risk.max_discover_time, '0001-01-01')
            ),
            '0001-01-01'
        ) AS update_time
        FROM
        -- 应急事件统计
        (SELECT
        IFNULL(SUM(total_rpt_count),0) AS total_evt_count,
        IFNULL(SUM(handl_count),0) AS handl_count,
        IFNULL(SUM(completed_count),0) AS completed_count,
        MAX(stat_time) AS max_stat_time
        FROM stat_mon_evt_rpt
        <where>
            <if test="startTime != null">AND stat_time &gt;= #{startTime}</if>
            <if test="endTime != null">AND stat_time &lt;= #{endTime}</if>
            <if test="regionShortCode != null and regionShortCode != ''">AND region_code = #{regionShortCode}</if>
        </where>
        ) AS evt,

        -- 应急资源统计
        (SELECT
        IFNULL(SUM(total_qty),0) AS total_res_count,
        MAX(update_time) AS max_res_time
        FROM biz_emerg_res
        <where>
            <if test="regionShortCode != null and regionShortCode != ''">
                <include refid="likeByRegionShortCode">
                    <property name="areaColumn" value="LEFT(dist_region,6)"/>
                    <property name="searchAreaCode" value="#{regionShortCode}"/>
                </include>
            </if>
        </where>
        ) AS res,

        -- 高风险隐患统计
        (SELECT
        IFNULL(COUNT(*),0) AS high_risk_count,
        MAX(discover_time) AS max_discover_time
        FROM biz_risk_hazard
        <where>
            <if test="regionShortCode != null and regionShortCode != ''">
                <include refid="likeByRegionShortCode">
                    <property name="areaColumn" value="LEFT(region_full_code,6)"/>
                    <property name="searchAreaCode" value="#{regionShortCode}"/>
                </include>
            </if>
            <if test="startTime != null">AND discover_time &gt;= #{startTime}</if>
            <if test="endTime != null">AND discover_time &lt;= #{endTime}</if>
        </where>
        ) AS risk,

        -- 行政区划覆盖数
        (SELECT IFNULL(COUNT(*),0) AS region_cover_count
        FROM sys_area
        <where>
            <if test="regionShortCode != null and regionShortCode != ''">
                parent_id = (SELECT id FROM sys_area WHERE short_code = #{regionShortCode})
            </if>
        </where>
        ) AS area
    </select>


</mapper>
