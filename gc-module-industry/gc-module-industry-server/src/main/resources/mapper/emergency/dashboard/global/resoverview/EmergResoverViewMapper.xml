<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.iocoder.yudao.module.industry.dal.mysql.emergency.dashboard.global.resoverview.EmergResoverViewMapper">
    <update id="updateStockAfterDispatch">
        UPDATE biz_emerg_res
        SET
            available_qty = #{newAvailableQty},
            dispatch_qty  = #{newDispatchQty},
            stock_status  = #{newStockStatus}
        WHERE res_id = #{resId}
    </update>


    <!-- 查询应急资源总览 -->
    <select id="listEmergResoverView"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.emergency.dashboard.global.resoverview.vo.EmergResoverViewRespVO"
            parameterType="cn.iocoder.yudao.module.industry.controller.admin.emergency.dashboard.global.resoverview.vo.EmergResoverViewQueryReqVO">

        SELECT
            res_id AS resId,
            res_name AS resName,
            res_type AS resType,
            total_qty AS totalQty,
            available_qty AS availableQty,
            storage_loc AS storageLoc,
            mngr_name AS mngrName,
            stock_status AS stockStatus,
            update_time as updateTime
        FROM biz_emerg_res
        WHERE 1=1

        <if test="resType != null and resType != ''">
            AND res_type = #{resType}
        </if>

        <if test="stockStatus != null and stockStatus != ''">
            AND stock_status = #{stockStatus}
        </if>

        <if test="regionFullCode != null and regionFullCode != ''">
            AND dist_region =#{regionFullCode}
        </if>

        <if test="keyword != null and keyword != ''">
            AND
            (
                res_name LIKE CONCAT('%', #{keyword}, '%')
                OR storage_loc LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
    </select>
    <select id="getByResId"
            resultType="cn.iocoder.yudao.module.industry.controller.admin.emergency.dashboard.global.resoverview.vo.EmergResoverViewRespVO">
        select * from biz_emerg_res
        where res_id = #{resId}
    </select>

</mapper>
