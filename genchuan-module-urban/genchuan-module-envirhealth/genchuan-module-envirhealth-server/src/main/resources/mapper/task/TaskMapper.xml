    </resultMap>

    <select id="selectDetailPageWithGarbageTransfer" resultMap="TaskDetailWithGarbageTransferResultMap">
        SELECT
        t.*,
        tt.name AS task_type_name,
        gt.name AS transfer_name,
        a.area_name AS area_name,
        u.user_name AS handle_name
        FROM task t
        LEFT JOIN sys_task_type tt ON t.task_type_id = tt.sys_task_type_id AND tt.deleted = 0
        LEFT JOIN garbage_transfer gt ON t.transfer_id = gt.transfer_id AND gt.deleted = 0
        LEFT JOIN sys_area a ON t.area_code = a.area_code AND a.deleted = 0
        LEFT JOIN sys_user u ON t.handle_by = u.user_id AND u.deleted = 0
        WHERE t.deleted = 0
          AND t.transfer_id IS NOT NULL
          AND t.transfer_id != ''
        ORDER BY t.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <select id="selectCountWithGarbageTransfer" resultType="java.lang.Long">
        SELECT COUNT(DISTINCT t.id)
        FROM task t
        INNER JOIN garbage_transfer gt
        ON t.transfer_id = gt.transfer_id
        WHERE t.deleted = 0
          AND t.transfer_id IS NOT NULL
          AND t.transfer_id != ''
    </select>


