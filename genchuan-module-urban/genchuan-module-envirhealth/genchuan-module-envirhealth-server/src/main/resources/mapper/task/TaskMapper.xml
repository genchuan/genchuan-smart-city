    <resultMap id="TaskDetailWithPublicToiletResultMap" type="cn.iocoder.yudao.module.envirhealth.dal.dataobject.task.detail.TaskDetailWithPublicToiletDO">

        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="task_type_id" property="taskTypeId"/>
        <result column="toilet_id" property="toiletId"/>
        <result column="area_code" property="areaCode"/>
        <result column="handle_by" property="handleBy"/>
        <result column="handle_result" property="handleResult"/>
        <result column="proof_url" property="proofUrl"/>
        <result column="complete_time" property="completeTime"/>
        <result column="handle_duration" property="handleDuration"/>
        <result column="stat_period" property="statPeriod"/>
        <result column="cleaning_qualified_rate" property="cleaningQualifiedRate"/>
        <result column="problem_complete_rate" property="problemCompleteRate"/>
        <result column="inspection_pass_rate" property="inspectionPassRate"/>
        <result column="total_entry_volume" property="totalEntryVolume"/>
        <result column="equipment_intact_rate" property="equipmentIntactRate"/>
        <result column="environment_qualified_rate" property="environmentQualifiedRate"/>
        <result column="satisfaction" property="satisfaction"/>

        <!-- 关联扩展字段 -->
        <result column="task_type_name" property="taskTypeName"/>
        <result column="toilet_name" property="toiletName"/>
        <result column="area_name" property="areaName"/>
        <result column="handle_name" property="handleName"/>
    </resultMap>

    <select id="selectDetailPageWithPublicToilet" resultMap="TaskDetailWithPublicToiletResultMap">
        SELECT
        t.*,
        ttp.name AS task_type_name,
        pt.name AS toilet_name,
        sa.area_name AS area_name,
        su.user_name AS handle_name
        FROM task t
            INNER JOIN public_toilet pt ON t.toilet_id = pt.toilet_id
            LEFT JOIN sys_task_type ttp ON t.task_type_id = ttp.sys_task_type_id
            LEFT JOIN sys_area sa ON t.area_code = sa.area_code
            LEFT JOIN sys_user su ON t.handle_by = su.user_id
        WHERE t.deleted = 0
          AND t.toilet_id IS NOT NULL
          AND t.toilet_id != ''
        ORDER BY t.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <select id="selectCountWithPublicToilet" resultType="java.lang.Long">
        SELECT COUNT(DISTINCT t.id)
        FROM task t
        INNER JOIN public_toilet pt
        ON t.toilet_id = pt.toilet_id
        WHERE t.deleted = 0
        AND t.toilet_id IS NOT NULL
        AND t.toilet_id != ''
    </select>


