    <select id="selectDetailPageWithPublicInstitution" resultMap="TaskDetailWithPublicInstitutionResultMap">
        SELECT
        t.*,
        tt.name AS task_type_name,
        a.area_name AS area_name,
        u.user_name AS handle_name,
        pi.name AS institution_name
        FROM task t
        LEFT JOIN sys_task_type tt ON t.task_type_id = tt.sys_task_type_id AND tt.deleted = 0
        LEFT JOIN sys_area a ON t.area_code = a.area_code AND a.deleted = 0
        LEFT JOIN sys_user u ON t.handle_by = u.user_id AND u.deleted = 0
        LEFT JOIN public_institution pi ON t.institution_id = pi.institution_id AND pi.deleted = 0
        WHERE t.deleted = 0
          AND t.institution_id IS NOT NULL
          AND t.institution_id != ''
        ORDER BY t.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <select id="selectCountWithPublicInstitution" resultType="Long">
        SELECT COUNT(DISTINCT t.id)
        FROM task t
        INNER JOIN public_institution pi
        ON t.institution_id = pi.institution_id
        WHERE t.deleted = 0
          AND t.institution_id IS NOT NULL
          AND t.institution_id != ''
