<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.envirhealth.dal.mysql.market.MarketMapper">

    <resultMap id="MarketDetailResultMap" type="cn.iocoder.yudao.module.envirhealth.dal.dataobject.market.detail.MarketDetailDO">
        <!-- 基础字段（继承自 MarketDO） -->
        <id column="id" property="id"/>
        <result column="market_id" property="marketId"/>
        <result column="name" property="name"/>
        <result column="address" property="address"/>
        <result column="area_code" property="areaCode"/>
        <result column="stall_count" property="stallCount"/>
        <result column="manager_id" property="managerId"/>
        <result column="operation_status_id" property="operationStatusId"/>
        <result column="hygiene_rate" property="hygieneRate"/>
        <result column="waste_transfer_rate" property="wasteTransferRate"/>
        <result column="sewage_rate" property="sewageRate"/>
        <result column="unfinished_task_count" property="unfinishedTaskCount"/>
        <result column="cleaning_frequency" property="cleaningFrequency"/>
        <result column="cleaning_time" property="cleaningTime"/>
        <result column="cleaning_area" property="cleaningArea"/>
        <result column="staff_ids" property="staffIds"/>
        <result column="cleaning_standard" property="cleaningStandard"/>
        <result column="garbage_type_ids" property="garbageTypeIds"/>
        <result column="garbage_container_count" property="garbageContainerCount"/>
        <result column="waste_transfer_interval" property="wasteTransferInterval"/>
        <result column="waste_transfer_time" property="wasteTransferTime"/>
        <result column="vehicle_id" property="vehicleId"/>
        <result column="sewage_discharge_area" property="sewageDischargeArea"/>
        <result column="sewage_disposal_way" property="sewageDisposalWay"/>
        <result column="sewage_cleaning_frequency" property="sewageCleaningFrequency"/>
        <result column="sewage_problem_desc" property="sewageProblemDesc"/>
        <result column="last_sewage_cleaning_time" property="lastSewageCleaningTime"/>
        <result column="next_sewage_cleaning_time" property="nextSewageCleaningTime"/>
        <result column="sewage_disposal_log" property="sewageDisposalLog"/>
        <result column="hygiene_check_time" property="hygieneCheckTime"/>
        <result column="check_by" property="checkBy"/>
        <result column="hygiene_check_date" property="hygieneCheckDate"/>
        <result column="previous_problem" property="previousProblem"/>
        <result column="qualified_item_count" property="qualifiedItemCount"/>
        <result column="unqualified_item_count" property="unqualifiedItemCount"/>
        <result column="reform_require" property="reformRequire"/>
        <result column="reform_deadline" property="reformDeadline"/>
        <result column="handle_status_id" property="handleStatusId"/>
        <result column="check_result_id" property="checkResultId"/>
        <result column="task_type_id" property="taskTypeId"/>
        <result column="ext_common1" property="extCommon1"/>
        <result column="ext_common2" property="extCommon2"/>
        <result column="ext_common3" property="extCommon3"/>
        <result column="ext_common4" property="extCommon4"/>

        <!-- 关联查询的扩展字段 -->
        <result column="area_name" property="areaName"/>
        <result column="manager_name" property="managerName"/>
        <result column="operation_status_name" property="operationStatusName"/>
        <result column="staffs_name_str" property="staffsNameStr"/>
        <result column="garbage_types_name_str" property="garbageTypesNameStr"/>
        <result column="vehicle_name" property="vehicleName"/>
        <result column="check_name" property="checkName"/>
        <result column="handle_status_name" property="handleStatusName"/>
        <result column="check_result_name" property="checkResultName"/>
        <result column="task_type_name" property="taskTypeName"/>
    </resultMap>

    <select id="selectDetailPage" resultMap="MarketDetailResultMap">
        SELECT
        m.*,
        a.area_name AS area_name,
        u1.user_name AS manager_name,
        os.name AS operation_status_name,
        IFNULL(GROUP_CONCAT(DISTINCT u2.user_name), '') AS staffs_name_str,
        IFNULL(GROUP_CONCAT(DISTINCT gt.name), '') AS garbage_types_name_str,
        v.license_plate AS vehicle_name,
        u3.user_name AS check_name,
        hs.name AS handle_status_name,
        cr.check_result_name AS check_result_name,
        tt.name AS task_type_name
        FROM market m
        LEFT JOIN sys_area a ON m.area_code = a.area_code AND a.deleted = 0
        LEFT JOIN sys_operation_status os ON m.operation_status_id = os.sys_operation_status_id AND os.deleted = 0
        LEFT JOIN sys_user u1 ON m.manager_id = u1.user_id AND u1.deleted = 0
        LEFT JOIN sys_user u2 ON FIND_IN_SET(
        u2.user_id,
        REPLACE(REPLACE(REPLACE(REPLACE(m.staff_ids, '[', ''), ']', ''), '"', ''), ' ', '')
        ) AND u2.deleted = 0
        LEFT JOIN sys_garbage_type gt ON FIND_IN_SET(
        gt.sys_garbage_type_id,
        REPLACE(REPLACE(REPLACE(REPLACE(m.garbage_type_ids, '[', ''), ']', ''), '"', ''), ' ', '')
        ) AND gt.deleted = 0
        LEFT JOIN sys_vehicle v ON m.vehicle_id = v.sys_vehicle_id AND v.deleted = 0
        LEFT JOIN sys_user u3 ON m.check_by = u3.user_id AND u3.deleted = 0
        LEFT JOIN sys_handle_status hs ON m.handle_status_id = hs.sys_handle_status_id AND hs.deleted = 0
        LEFT JOIN sys_check_result cr ON m.check_result_id = cr.check_result_id AND cr.deleted = 0
        LEFT JOIN sys_task_type tt ON m.task_type_id = tt.sys_task_type_id AND tt.deleted = 0
        WHERE m.deleted = 0
        GROUP BY m.id, a.area_name, os.name, u1.user_name, v.license_plate, u3.user_name, hs.name, cr.check_result_name, tt.name
        ORDER BY m.id DESC
        LIMIT #{reqVO.offset}, #{reqVO.pageSize}
    </select>

    <select id="selectCount" resultType="Long">
        SELECT COUNT(DISTINCT m.id)
        FROM market m
        WHERE m.deleted = 0
    </select>

</mapper>